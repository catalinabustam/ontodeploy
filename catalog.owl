<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcat="http://www.w3.org/ns/dcat#"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <rdf:Description rdf:about="https://w3id.org/arc/">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
    <dcterms:title>arc ontologies</dcterms:title>
    <dcat:dataset rdf:resource="https://w3id.org/arc/testo/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arc/testo/">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <dcterms:title>Ontostart Test Ontology</dcterms:title>
    <dcterms:description>The Ontostart Test Ontology.</dcterms:description>
    <owl:versionInfo>0.0.2</owl:versionInfo>
    <dcat:landingPage rdf:resource="https://catalinabustam.github.io/ontodeploy/testo/"/>
    <dcat:distribution rdf:nodeID="dist-testo-ttl"/>
    <dcat:distribution rdf:nodeID="dist-testo-jsonld"/>
    <dcat:distribution rdf:nodeID="dist-testo-nt"/>
    <dcat:distribution rdf:nodeID="dist-testo-owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="dist-testo-ttl">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <dcat:downloadURL rdf:resource="https://catalinabustam.github.io/ontodeploy/testo/versions/latest/testo.ttl"/>
    <dcat:mediaType>text/turtle</dcat:mediaType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="dist-testo-jsonld">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <dcat:downloadURL rdf:resource="https://catalinabustam.github.io/ontodeploy/testo/versions/latest/testo.jsonld"/>
    <dcat:mediaType>application/ld+json</dcat:mediaType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="dist-testo-nt">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <dcat:downloadURL rdf:resource="https://catalinabustam.github.io/ontodeploy/testo/versions/latest/testo.nt"/>
    <dcat:mediaType>application/n-triples</dcat:mediaType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="dist-testo-owl">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <dcat:downloadURL rdf:resource="https://catalinabustam.github.io/ontodeploy/testo/versions/latest/testo.owl"/>
    <dcat:mediaType>application/rdf+xml</dcat:mediaType>
  </rdf:Description>
</rdf:RDF>
