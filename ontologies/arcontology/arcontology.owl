  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/Diarrhoea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="N77fc34ded7044917928d652d79fdaf4d"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/62315008"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C3554472"/>
    <rdfs:label xml:lang="en">Diarrhoea</rdfs:label>
    <skos:definition xml:lang="en">Defined as abnormally increased frequency (usually defined as three or more) loose or liquid bowel movement per day (or more frequent passage than is normal for the individual).</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/AdsymSkinrash">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="N7c1d749ee1294659b494c2d7d7aae518"/>
    <rdfs:subClassOf rdf:nodeID="Naeab1e8afaf5449a94a9a431bea3c254"/>
    <rdfs:subClassOf rdf:nodeID="N0a66cfbcc4d1444f9600149d76a9bf5e"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/271807003"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C4227880"/>
    <rdfs:label xml:lang="en">Skin rash</rdfs:label>
    <skos:definition xml:lang="en">This refers to any change in the skin which affects its appearance or texture. A rash may be localized to one part of the body or affect all the skin. Rashes may cause the skin to change colour, itch, become warm, bumpy, dry, cracked, or blistered, swell and may be painful.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation.</rdfs:comment>
  </rdf:Description>
