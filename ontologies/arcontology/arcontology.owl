  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/SymptDiarrhoea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/questions/Diarrhoea"/>
    <rdfs:subClassOf rdf:nodeID="N78a8291eabb646acaab9c6988a7ab36a"/>
    <rdfs:subClassOf rdf:nodeID="N9fc367336cec4ab6a22bc120e5888763"/>
    <rdfs:subClassOf rdf:nodeID="N703523a7b19647d59434e8fb4642f9b0"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C3554472"/>
    <rdfs:label xml:lang="en">Diarrhoea</rdfs:label>
    <skos:definition xml:lang="en">Defined as three or more loose or liquid bowel movement per day (or more frequent passage than is normal for the individual).</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment.</rdfs:comment>
  </rdf:Description>
