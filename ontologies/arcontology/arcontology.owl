    <rdfs:label xml:lang="en">Heart Rate (bpm)</rdfs:label>
    <skos:definition xml:lang="en">Refers to heart rate measured in beats per minute. This may be measured manually or by electronic monitoring.</skos:definition>
    <rdfs:comment xml:lang="en">Enter the heart rate measured in beats per minute. Record the value furthest from normal range between 00:00 to 24:00 on day of assessment.</rdfs:comment>
  </rdf:Description>
