  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/NbornJaund">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/questions/Jaundice"/>
    <rdfs:subClassOf rdf:nodeID="N8711eb8561194e1a875f3d393f640728"/>
    <rdfs:subClassOf rdf:nodeID="N5f6ad197933e4ec48093593cdca5f7dc"/>
    <rdfs:label xml:lang="en">Jaundice</rdfs:label>
    <skos:definition xml:lang="en">Defined as a clinical manifestation of hyperbilirubinemia, characterized by the yellowish staining of the skin, mucous membrane and/or sclera.</skos:definition>
    <rdfs:comment xml:lang="en">Jaundice</rdfs:comment>
  </rdf:Description>
