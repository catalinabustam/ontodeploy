    <skos:exactMatch rdf:resource="http://snomed.info/id/250774007"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0428648"/>
    <rdfs:label xml:lang="en">Any supplemental oxygen?</rdfs:label>
    <skos:definition xml:lang="en">This refers to any method of supplemental oxygen therapy that may be delivered via nose cannula, mask or non-invasive or invasive ventilation.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient experienced was given or prescribed supplemental oxygen therapy at any time during hospitalisation.</rdfs:comment>
  </rdf:Description>
