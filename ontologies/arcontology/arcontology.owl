    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0086839"/>
    <rdfs:label xml:lang="en">Post-partum (within 6 weeks of delivery)</rdfs:label>
    <skos:definition xml:lang="en">This refers to the temporal period relating to mother from completion of labour until six weeks post-delivery.</skos:definition>
