  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/UrinaryRetention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="Nc5da5ffa96224880b6e6f13bcd471209"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/267064002"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0080274"/>
    <rdfs:label xml:lang="en">Urinary retention</rdfs:label>
    <skos:definition xml:lang="en">Defined as the accumulation of urine within the bladder because of the inability to urinate.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation.</rdfs:comment>
  </rdf:Description>
