  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/VacciCovid19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="N06591824b4e240db80ec8397c14dc638"/>
    <rdfs:subClassOf rdf:nodeID="Nf8b4f78e32bf402b95b277bc392b5ac0"/>
    <rdfs:label xml:lang="en">Vaccinated for COVID-19 (ever)</rdfs:label>
    <skos:definition xml:lang="en">Ever received a vaccine targeted against SARS-Cov-2. Examples include Spikevax (Moderna), Comirnaty (Pfizer/BioNTech), Nuvaxovid (Novavax), Vaxzevria (AstraZeneca/Oxford), Janssen COVID-19 Vaccine (Johnson &amp; Johnson), Valneva (Valneva).</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient has ever received a vaccine targetted against SARS-Cov-2</rdfs:comment>
  </rdf:Description>
