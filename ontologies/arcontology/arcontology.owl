  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/Jaundice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="N9f9ef9f1cb4b4339bf7cffc427b4bc36"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/18165001"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C3549846"/>
    <rdfs:label xml:lang="en">Jaundice</rdfs:label>
    <skos:definition xml:lang="en">Defined as a clinical manifestation of hyperbilirubinemia, characterized by the yellowish staining of the skin, mucous membrane and/or sclera.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation.</rdfs:comment>
  </rdf:Description>
