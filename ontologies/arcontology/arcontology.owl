  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/Diarrhoea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="N1b1d72b4d5a442e7a5088628e7e81d84"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/62315008"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C3554472"/>
    <rdfs:label xml:lang="en">Diarrhoea</rdfs:label>
    <skos:definition xml:lang="en">Defined as abnormally increased frequency (usually defined as three or more) loose or liquid bowel movement per day (or more frequent passage than is normal for the individual).</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation.</rdfs:comment>
  </rdf:Description>
