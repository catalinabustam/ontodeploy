    <skos:exactMatch rdf:resource="http://snomed.info/id/698247007"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0003811"/>
    <rdfs:label xml:lang="en">Cardiac arrhythmia</rdfs:label>
    <skos:definition xml:lang="en">Refers to an abnormality in rhythm of heartbeat, including rate, regularity, and/or sequence of activation abnormalities</skos:definition>
