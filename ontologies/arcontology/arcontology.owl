    <rdfs:label xml:lang="en">Frequency</rdfs:label>
    <skos:definition xml:lang="en">Refers to the frequency of specified medicine administration in a 24-hour period (00:00 to 24:00 hours). Examples include 'every 4 hours', 'twice daily' etc.</skos:definition>
