  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/Anaemia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="Nc221ccdb79a246cba2674e8dfb9645f5"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/271737000"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0002871"/>
    <rdfs:label xml:lang="en">Anaemia</rdfs:label>
    <skos:definition xml:lang="en">This refers to a reduction in the number of red blood cells, the amount of hemoglobin, and/or the volume of packed red blood cells. Common manifestations include pallor, fatigue, dizziness, shortness of breath, and tachycardia.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation.</rdfs:comment>
  </rdf:Description>
