    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0549206"/>
    <rdfs:label xml:lang="en">Pregnant</rdfs:label>
    <skos:definition xml:lang="en">This refers to women who reports to be pregnant at presentation and/or have had a positive pregnancy test in recent days prior to presentation.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient is pregnant at presentation. If the patient is of fertile age with no negative pregnancy test select 'Unknown'.</rdfs:comment>
  </rdf:Description>
