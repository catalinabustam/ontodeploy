    <skos:exactMatch rdf:resource="http://snomed.info/id/422400008"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C4230730"/>
    <rdfs:label xml:lang="en">Vomiting</rdfs:label>
    <skos:definition xml:lang="en">Defined as the expulsion of the stomach or small intestines through the mouth.</skos:definition>
