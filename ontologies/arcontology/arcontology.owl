  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/AdsymFever">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="Nfc0549aaccc1447daedd13b8bc69bf23"/>
    <rdfs:subClassOf rdf:nodeID="N72802cdab6864f00b8f1d1120530fcf4"/>
    <rdfs:subClassOf rdf:nodeID="Ncdffb4d5c03f4350b5f2c1cf8564e50b"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/386661006"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0015967"/>
    <rdfs:label xml:lang="en">Fever</rdfs:label>
    <skos:definition xml:lang="en">This refers to sensation of elevated body temperature without formal measurement, or a measured body temperature greater or equal to 38-degrees Celsius (38°C) or 100.4-Fahrenheit (100.4°F).</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient experienced this at any time during the date of assessment.</rdfs:comment>
  </rdf:Description>
