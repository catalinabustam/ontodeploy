    <skos:exactMatch rdf:resource="http://snomed.info/id/129018004"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0040802"/>
    <rdfs:label xml:lang="en">Did the patient travel outside of their home region in the past 14 days?</rdfs:label>
    <skos:definition xml:lang="en">This refers to travel to another city/town or region, another part of the country or abroad to another country within 14 days before symptoms relating to the current illness began.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient travelled to another city/town or region, another part of the country or abroad to another country within 14 days before symptoms relating to the current illness began.</rdfs:comment>
  </rdf:Description>
