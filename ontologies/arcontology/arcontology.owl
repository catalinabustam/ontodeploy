  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/ComorLiverdisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="N90b1ccddb8914332837efeac96d79fbf"/>
    <rdfs:subClassOf rdf:nodeID="N9da7ea54af704cb1ae2784d6565affad"/>
    <rdfs:subClassOf rdf:nodeID="Nd1f4120340584f48b85893825185bb6b"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/235856003"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0023895"/>
    <rdfs:label xml:lang="en">Liver disease</rdfs:label>
    <skos:definition xml:lang="en">Defined as any disorder of the hepatobiliary system. Manifestations may include signs and symptoms of cholestasis, portal hypertension, and/or abnormal liver function tests.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if this is condition existed prior to admission and is ongoing.</rdfs:comment>
  </rdf:Description>
