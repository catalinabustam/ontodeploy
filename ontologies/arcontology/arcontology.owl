  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="https://w3id.org/sulo"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <owl:versionIRI rdf:resource="https://w3id.org/arc/arcontology/releases/1.0.0/arc/arcontology.owl"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0.0</owl:versionInfo>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARC SULO Ontology </rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An SULO OWL ontology for ISARIC ARC  - Analysis and Research Compendiumdata dictionary, built incrementally through the SULO ARC tutorial. Models question classes, form sections, answer-option collections, body-system references, and skos:exactMatch links to SNOMED CT, LOINC, and UMLS, all using SULO upper-level patterns.</rdfs:comment>
    <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARC SULO Ontology </dcterms:title>
    <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An SULO OWL ontology for ISARIC ARC  - Analysis and Research Compendiumdata dictionary, built incrementally through the SULO ARC tutorial. Models question classes, form sections, answer-option collections, body-system references, and skos:exactMatch links to SNOMED CT, LOINC, and UMLS, all using SULO upper-level patterns.</dcterms:description>
