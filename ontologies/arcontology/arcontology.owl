    <rdfs:subClassOf rdf:nodeID="N8b18925d95d144e5b463b5a4e2cb6db6"/>
    <rdfs:subClassOf rdf:nodeID="N1aef64a65cf6422aaf75c881baa480e8"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C0080274"/>
    <rdfs:label xml:lang="en">Urinary retention</rdfs:label>
    <skos:definition xml:lang="en">Defined as the accumulation of urine within the bladder because of the inability to urinate.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment.</rdfs:comment>
  </rdf:Description>
