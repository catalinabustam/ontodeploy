  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/SignAnaemia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/questions/Anaemia"/>
    <rdfs:subClassOf rdf:nodeID="N711ec5f12cdc42edb61cd07bfafdc4ba"/>
    <rdfs:subClassOf rdf:nodeID="Nc75cdb85fabb4a4aa7b9db8bcd1c0b03"/>
    <rdfs:subClassOf rdf:nodeID="N9223a981a05646bb883d8ff45ace5a24"/>
    <rdfs:label xml:lang="en">Anaemia</rdfs:label>
    <skos:definition xml:lang="en">This refers to a reduction in the number of red blood cells, the amount of hemoglobin, and/or the volume of packed red blood cells. Common manifestations include pallor, fatigue, dizziness, shortness of breath, and tachycardia.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment.</rdfs:comment>
  </rdf:Description>
