  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/IntravenousParenteralFluids">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="Na0659ce782844ab3be6be49eb44519d8"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/354078009"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/CL524079"/>
    <rdfs:label xml:lang="en">Intravenous (parenteral) fluids</rdfs:label>
    <skos:definition xml:lang="en">Intravenous (IV) or parenteral fluids are prescribed as a replacement of fluid, electrolytes, calories, vitamins, and other nutritional substances. Intravenous fluids may be used for rehydration, maintenance requirements or resuscitation.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes' if the patient received intravenous fluids in the 7 days prior to this most recent admission / presentation.</rdfs:comment>
  </rdf:Description>
