    <rdfs:subClassOf rdf:resource="https://w3id.org/sulo/Process"/>
    <rdfs:label xml:lang="en">Summary of Medication and Pathogen Testing</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the complete medication and laboratory testing workflow during hospitalisation as documented in the ARC protocol.</rdfs:comment>
