  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/ComorAsthma">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="N563d5d6890424e39afe5e230405a6ce7"/>
    <rdfs:subClassOf rdf:nodeID="N3b8dc1a3ae554071b031fc3986446178"/>
    <rdfs:subClassOf rdf:nodeID="N38c112064367473ea6bca88109df7c58"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/195967001"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C4229310"/>
    <rdfs:label xml:lang="en">Asthma</rdfs:label>
    <skos:definition xml:lang="en">This is defined as clinician-diagnosed asthma, a chronic airway disorder characterized by variable and recurring symptoms of airflow obstruction, bronchial hyper-responsiveness, and/or underlying inflammation. Current pharmaceutical intervention - for prevention or treatment of symptoms - is not a pre-requisite for the inclusion of this diagnosis.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if this is condition existed prior to admission with this current illness and remains an active medical condition.</rdfs:comment>
  </rdf:Description>
