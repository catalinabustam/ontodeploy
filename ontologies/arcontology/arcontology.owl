  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/IncluCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/ListQuestionSingle"/>
    <rdfs:subClassOf rdf:nodeID="Nf9a704917049438381d148f04626ae85"/>
    <rdfs:subClassOf rdf:nodeID="Nf75375465e3c41f7abf4d2950b1d32f3"/>
    <rdfs:subClassOf rdf:nodeID="N2795f4184e9a4cc8a364c71df8c8b6b7"/>
    <rdfs:subClassOf rdf:nodeID="Nfc96f75d4e4b4afbabd6a6dec290f702"/>
    <rdfs:label xml:lang="en">Case classification status</rdfs:label>
    <skos:definition xml:lang="en">Confirmed refers to a case that is laboratory confirmed and may fulfil the clinical criteria as described in the case definition. Probable refers to a clinically compatible illness that is epidemiologically linked to a confirmed case without laboratory confirmation of infection with pathogen of interest. Suspected refers to a clinically compatible illness without epidemiological link or laboratory confirmation. Discarded refers to a patient with a negative laboratory test and has failed to fulfil the criteria for a suspect, probable or confirmed case.</skos:definition>
    <rdfs:comment xml:lang="en">Select the most appropriate option that represents the status of the case.</rdfs:comment>
  </rdf:Description>
