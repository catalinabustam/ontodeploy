  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/ComplJaundice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/questions/Jaundice"/>
    <rdfs:subClassOf rdf:nodeID="Ncb05506e54894b9aae8861d4e9ec92fc"/>
    <rdfs:subClassOf rdf:nodeID="N7f0ffe2db7c14701bfce98137561660e"/>
    <rdfs:subClassOf rdf:nodeID="N7aafb71dd2214e6286cfddb82a9f84c2"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/18165001"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C3549846"/>
    <rdfs:label xml:lang="en">Jaundice</rdfs:label>
    <skos:definition xml:lang="en">This refers to a clinical manifestation of hyperbilirubinemia, characterized by the yellowish staining of the skin, mucous membrane and/or sclera.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if the patient experienced this at any time during hospitalisation.</rdfs:comment>
  </rdf:Description>
