  <rdf:Description rdf:about="https://w3id.org/arc/arcontology/questions/ComorDiabetes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arc/arcontology/YNUQuestion"/>
    <rdfs:subClassOf rdf:nodeID="N77f171853c35421abc868ff4b59e9985"/>
    <rdfs:subClassOf rdf:nodeID="N35779bfdd9b543d2b4674f8dd87b5932"/>
    <rdfs:subClassOf rdf:nodeID="N1911c17cccdb4e70aead6081d020f4b2"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/73211009"/>
    <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/UMLS/C4013416"/>
    <rdfs:label xml:lang="en">Diabetes mellitus</rdfs:label>
    <skos:definition xml:lang="en">Defined as a metabolic disorder characterized by abnormally high blood sugar levels due to diminished production of insulin or insulin resistance or desensitization. This includes Type 1 diabetes mellitus, Type 2 diabetes mellitus, or Gestational diabetes (during previous pregnancy) requiring oral or subcutaneous treatment.</skos:definition>
    <rdfs:comment xml:lang="en">Indicate 'Yes', if this is condition existed prior to admission with this current illness and remains an active medical condition.</rdfs:comment>
  </rdf:Description>
