:ARCSection a owl:Class ;
    rdfs:label "ARC Section"@en ;
    rdfs:comment "A logical grouping of ARC variables within a form. Sections are direct parts of their parent ARCForm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom :ARCQuestion ],
        sulo:InformationObject .

:YNUQuestion a owl:Class ;
    rdfs:label "yes/no/unknown question"@en ;
    rdfs:comment "A question whose answer is a single choice among three options: Yes, No or Unknown."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom :YNUCollection ],
        :ARCQuestion .

