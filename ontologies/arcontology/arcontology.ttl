:YNUQuestion a owl:Class ;
    rdfs:label "yes/no/unknown question"@en ;
    rdfs:comment "A question whose answer is a single choice among three options: Yes, No or Unknown."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom :YNUCollection ],
        :ARCQuestion .

:DiseaseCollection a owl:Class ;
    rdfs:label "disease answer option collection"@en ;
    rdfs:comment "A collection of infections, conditions and clinical syndromes that can be suspected or confirmed. ARC list: inclusion_Diseases. Its items are added as named individuals in a later notebook."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :ExposureToCBRNAgent ;
            owl:onProperty sulo:hasItem ],
