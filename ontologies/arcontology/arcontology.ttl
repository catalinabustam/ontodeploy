@prefix : <https://w3id.org/arc/arcontology/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:description a owl:AnnotationProperty .

: a owl:Ontology ;
    rdfs:label "ARC SULO Ontology "^^xsd:string ;
    dc:creator "https://orcid.org/0000-0002-8048-6295"^^xsd:string ;
    dcterms:alternative "arcontology"^^xsd:string ;
    dcterms:bibliographicCitation "Unpublished tutorial ontology — ARC SULO series"^^xsd:string ;
    dcterms:contributor "https://orcid.org/0000-0002-8048-6295"^^xsd:string ;
    dcterms:created "2026-11-27T20:40:13.764177+00:00"^^xsd:string ;
    dcterms:description "An SULO OWL ontology for ISARIC ARC  - Analysis and Research Compendiumdata dictionary, built incrementally through the SULO ARC tutorial. Models question classes, form sections, answer-option collections, body-system references, and skos:exactMatch links to SNOMED CT, LOINC, and UMLS, all using SULO upper-level patterns."^^xsd:string ;
    dcterms:issued "2026-11-27"^^xsd:string ;
    dcterms:language "http://lexvo.org/id/iso639-1/en"^^xsd:string ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:string ;
    dcterms:modified "2026-11-27T20:40:13.764177+00:00"^^xsd:string ;
    dcterms:publisher "https://github.com/catalinabustam"^^xsd:string ;
    dcterms:title "ARC SULO Ontology "^^xsd:string ;
    pav:authoredBy "https://orcid.org/0000-0002-8048-6295"^^xsd:string ;
    vann:preferredNamespacePrefix "arcontology"^^xsd:string ;
    vann:preferredNamespaceUri "https://w3id.org/arc/arcontology/"^^xsd:string ;
    rdfs:comment "An SULO OWL ontology for ISARIC ARC  - Analysis and Research Compendiumdata dictionary, built incrementally through the SULO ARC tutorial. Models question classes, form sections, answer-option collections, body-system references, and skos:exactMatch links to SNOMED CT, LOINC, and UMLS, all using SULO upper-level patterns."^^xsd:string ;
    owl:imports <http://www.w3.org/2004/02/skos/core>,
        <https://w3id.org/sulo> ;
    owl:versionIRI <https://w3id.org/arc/arcontology/releases/1.0.0/arc/arcontology.owl> ;
    owl:versionInfo "1.0.0"^^xsd:string ;
    dcat:accessURL "https://w3id.org/arc/arcontology/"^^xsd:string ;
    foaf:homepage "https://github.com/catalinabustam/ontodeploy/arcontology"^^xsd:string ;
    mod:definitionProperty "http://www.w3.org/2000/01/rdf-schema#comment"^^xsd:string ;
    mod:hasRepresentationLanguage "http://omv.ontoware.org/2005/05/ontology#OWL"^^xsd:string ;
    mod:hasSyntax "http://www.w3.org/ns/formats/Turtle"^^xsd:string ;
    mod:prefLabelProperty "http://www.w3.org/2000/01/rdf-schema#label"^^xsd:string ;
    mod:status "active"^^xsd:string .

:DailyForm a owl:Class ;
    rdfs:label "Daily Assessment Form"@en ;
    rdfs:comment "Form completed once per day during hospitalisation. Maps to the ARC 'daily' instrument."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :AdvancedCareInterventionsSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :RespiratorySupportSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :LaboratoryResultsSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :SymptomsSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :VitalSignsAndAssessmentsSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :TreatmentsAndInterventionsSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :SignsSection ],
        :ARCForm ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ARCForm [ a owl:Restriction ;
                        owl:onProperty sulo:refersTo ;
                        owl:someValuesFrom :Daily ] ) ] .

:FollowUpForm a owl:Class ;
    rdfs:label "Follow-Up Form"@en ;
    rdfs:comment "Form completed at the scheduled post-discharge follow-up visit. Maps to the ARC 'follow_up' instrument."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :FollowUpAssessmentSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :ARCForm ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ARCForm [ a owl:Restriction ;
                        owl:onProperty sulo:refersTo ;
                        owl:someValuesFrom :FollowUp ] ) ] .

:MedicationForm a owl:Class ;
    rdfs:label "Medication Form"@en ;
    rdfs:comment "Form used to capture details of a single medication episode. Maps to the ARC 'medication' instrument."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :MedicationSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :ARCForm ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ARCForm [ a owl:Restriction ;
                        owl:onProperty sulo:refersTo ;
                        owl:someValuesFrom :SummaryMedicationTesting ] ) ] .

:OutcomeForm a owl:Class ;
    rdfs:label "Outcome Form"@en ;
    rdfs:comment "Form completed at hospital discharge or study endpoint. Maps to the ARC 'outcome' instrument."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :InterventionsSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :RespiratorySupportOutcomeSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OutcomeSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :DiagnosisSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :ComplicationsSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :ARCForm ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ARCForm [ a owl:Restriction ;
                        owl:onProperty sulo:refersTo ;
                        owl:someValuesFrom :OutcomeEndOfStudy ] ) ] .

:PathogenTestingForm a owl:Class ;
    rdfs:label "Pathogen Testing Form"@en ;
    rdfs:comment "Form capturing pathogen testing results for one sample. Maps to the ARC 'pathogen_testing' instrument."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :PathogenTestingSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :ARCForm ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ARCForm [ a owl:Restriction ;
                        owl:onProperty sulo:refersTo ;
                        owl:someValuesFrom :SummaryMedicationTesting ] ) ] .

:PresentationForm a owl:Class ;
    rdfs:label "Presentation Form"@en ;
    rdfs:comment "Form completed at the time of hospital presentation. Maps to the ARC 'presentation' instrument."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :DemographicsSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :VaccinationSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :SymptomsOnAdmissionSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :PregnancyPresentationSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :MedicationPriorToAdmissionSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :ComorbiditiesAndRiskFactorsSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OnsetAndPresentationSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :ExposureHistorySection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :InclusionCriteriaSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :SignsOnAdmissionSection ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :ARCForm ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ARCForm [ a owl:Restriction ;
                        owl:onProperty sulo:refersTo ;
                        owl:someValuesFrom :InitialAssessmentAdmission ] ) ] .

:SubjId a owl:Class ;
    rdfs:label "Participant Identification Number (PIN)"@en ;
    rdfs:comment "Write the Participant Identification Number (PIN)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isFeatureOf ;
            owl:someValuesFrom :ARCCRF ],
        [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom :Person ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasValue ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:hasValue "subjid"^^xsd:string ;
            owl:onProperty skos:notation ],
        sulo:InformationObject ;
    skos:definition "The Participant Identification Number or PIN is a unique number used to identify the patient's (participant's) data."@en .

<https://w3id.org/arc/arcontology/questions/AdsignAnaemia> a owl:Class ;
    rdfs:label "Anaemia"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue :Haematology ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "adsign_anaemia"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/Anaemia> ;
    skos:definition "This refers to a reduction in the number of red blood cells, the amount of hemoglobin, and/or the volume of packed red blood cells. Common manifestations include pallor, fatigue, dizziness, shortness of breath, and tachycardia."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0002871>,
        <http://snomed.info/id/271737000> .

<https://w3id.org/arc/arcontology/questions/AdsignApnoea> a owl:Class ;
    rdfs:label "Apnoea"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Respiratory ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue "adsign_apnoea"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/Apnoea> ;
    skos:definition "Defined as a transient absence in spontaneous respiration."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0003578>,
        <http://snomed.info/id/1023001> .

<https://w3id.org/arc/arcontology/questions/AdsignArrhythmia> a owl:Class ;
    rdfs:label "Cardiac arrhythmia"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Cardiovascular ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue "adsign_arrhythmia"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/CardiacArrhythmia> ;
    skos:definition "Refers to an abnormality in rhythm of heartbeat, including rate, regularity, and/or sequence of activation abnormalities"@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0003811>,
        <http://snomed.info/id/698247007> .

<https://w3id.org/arc/arcontology/questions/AdsignConjunctiv> a owl:Class ;
    rdfs:label "Conjunctivitis"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue :Ocular ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "adsign_conjunctiv"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/Conjunctivitis> ;
    skos:definition "Defined as inflammation of the conjunctiva"@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4011653>,
        <http://snomed.info/id/9826008> .

<https://w3id.org/arc/arcontology/questions/AdsignJaund> a owl:Class ;
    rdfs:label "Jaundice"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue "adsign_jaund"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :Gastrointestinal ;
            owl:onProperty sulo:refersTo ],
        <https://w3id.org/arc/arcontology/questions/Jaundice> ;
    skos:definition "Defined as a clinical manifestation of hyperbilirubinemia, characterized by the yellowish staining of the skin, mucous membrane and/or sclera."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C3549846>,
        <http://snomed.info/id/18165001> .

<https://w3id.org/arc/arcontology/questions/AdsymCough> a owl:Class ;
    rdfs:label "Cough"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsym_cough"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue :Respiratory ;
            owl:onProperty sulo:refersTo ],
        :YNUQuestion ;
    skos:definition "This refers to the presence of a cough and its characteristics. A productive cough refers to a cough accompanied by expectorated secretions (phlegm or mucus), while a non-productive cough refers to one which is not accompanied by expectorated secretions. Haemoptysis refers to the presence of blood or blood-streaked sputum from the respiratory tract."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0010200>,
        <http://snomed.info/id/49727002> .

<https://w3id.org/arc/arcontology/questions/AdsymDiarrhoea> a owl:Class ;
    rdfs:label "Diarrhoea"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsym_diarrhoea"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue :Gastrointestinal ;
            owl:onProperty sulo:refersTo ],
        <https://w3id.org/arc/arcontology/questions/Diarrhoea> ;
    skos:definition "Defined as abnormally increased frequency (usually defined as three or more) loose or liquid bowel movement per day (or more frequent passage than is normal for the individual)."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C3554472>,
        <http://snomed.info/id/62315008> .

<https://w3id.org/arc/arcontology/questions/AdsymFever> a owl:Class ;
    rdfs:label "Fever"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this at any time during the date of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :SystemicGeneral ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue "adsym_fever"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "This refers to sensation of elevated body temperature without formal measurement, or a measured body temperature greater or equal to 38-degrees Celsius (38°C) or 100.4-Fahrenheit (100.4°F)."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0015967>,
        <http://snomed.info/id/386661006> .

<https://w3id.org/arc/arcontology/questions/AdsymHeadache> a owl:Class ;
    rdfs:label "Headache"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue :NervousSystem ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "adsym_headache"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Defined as the experience of pain in various parts of the head."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0018681>,
        <http://snomed.info/id/25064002> .

<https://w3id.org/arc/arcontology/questions/AdsymShortbreat> a owl:Class ;
    rdfs:label "Shortness of breath"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue "adsym_shortbreat"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :Respiratory ;
            owl:onProperty sulo:refersTo ],
        :YNUQuestion ;
    skos:definition "Defined as the uncomfortable sensation of difficult or laboured breathing that is out of proportion to the patient's level of physical activity."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4230442>,
        <http://snomed.info/id/267036007> .

<https://w3id.org/arc/arcontology/questions/AdsymSkinpallor> a owl:Class ;
    rdfs:label "Skin pallor"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsym_skinpallor"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :SystemicGeneral ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsOnAdmissionSection ],
        <https://w3id.org/arc/arcontology/questions/SkinPallor> ;
    skos:definition "This refers to unnatural pale appearance of the skin."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0241137> .

<https://w3id.org/arc/arcontology/questions/AdsymSkinrash> a owl:Class ;
    rdfs:label "Skin rash"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :SystemicGeneral ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "adsym_skinrash"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsOnAdmissionSection ],
        :YNUQuestion ;
    skos:definition "This refers to any change in the skin which affects its appearance or texture. A rash may be localized to one part of the body or affect all the skin. Rashes may cause the skin to change colour, itch, become warm, bumpy, dry, cracked, or blistered, swell and may be painful."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4227880>,
        <http://snomed.info/id/271807003> .

<https://w3id.org/arc/arcontology/questions/AdsymUrine> a owl:Class ;
    rdfs:label "Urinary retention"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Genitourinary ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "adsym_urine"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsOnAdmissionSection ],
        <https://w3id.org/arc/arcontology/questions/UrinaryRetention> ;
    skos:definition "Defined as the accumulation of urine within the bladder because of the inability to urinate."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0080274>,
        <http://snomed.info/id/267064002> .

<https://w3id.org/arc/arcontology/questions/AdsymVomit> a owl:Class ;
    rdfs:label "Vomiting"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsym_vomit"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsOnAdmissionSection ],
        [ a owl:Restriction ;
            owl:hasValue :Gastrointestinal ;
            owl:onProperty sulo:refersTo ],
        <https://w3id.org/arc/arcontology/questions/Vomiting> ;
    skos:definition "Defined as the expulsion of the stomach or small intestines through the mouth."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4230730>,
        <http://snomed.info/id/422400008> .

<https://w3id.org/arc/arcontology/questions/ComorAsthma> a owl:Class ;
    rdfs:label "Asthma"@en ;
    rdfs:comment "Indicate 'Yes', if this is condition existed prior to admission with this current illness and remains an active medical condition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Respiratory ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComorbiditiesAndRiskFactorsSection ],
        [ a owl:Restriction ;
            owl:hasValue "comor_asthma"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "This is defined as clinician-diagnosed asthma, a chronic airway disorder characterized by variable and recurring symptoms of airflow obstruction, bronchial hyper-responsiveness, and/or underlying inflammation. Current pharmaceutical intervention - for prevention or treatment of symptoms - is not a pre-requisite for the inclusion of this diagnosis."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4229310>,
        <http://snomed.info/id/195967001> .

<https://w3id.org/arc/arcontology/questions/ComorChrkidney> a owl:Class ;
    rdfs:label "Chronic kidney disease"@en ;
    rdfs:comment "Indicate 'Yes', if this is condition existed prior to admission with this current illness and remains an active medical condition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Renal ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "comor_chrkidney"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComorbiditiesAndRiskFactorsSection ],
        :YNUQuestion ;
    skos:definition "This is defined as a clinician-diagnosed chronic kidney disease (CKD, also known as chronic kidney failure). The KDIGO and KDOQI definition of chronic kidney disease is kidney damage for 3 months, as defined by structural or functional abnormalities of the kidney, with or without decreased glomerular filtration rate (GFR), that can lead to decreased GFR, manifest by either: Pathologic abnormalities; or Markers of kidney damage, including abnormalities in the composition of the blood or urine, or abnormalities in imaging tests; or GFR <60 mL/min/1.73 m^2 for 3 months, with or without kidney damage."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C1561643>,
        <http://snomed.info/id/709044004> .

<https://w3id.org/arc/arcontology/questions/ComorDiabetes> a owl:Class ;
    rdfs:label "Diabetes mellitus"@en ;
    rdfs:comment "Indicate 'Yes', if this is condition existed prior to admission with this current illness and remains an active medical condition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComorbiditiesAndRiskFactorsSection ],
        [ a owl:Restriction ;
            owl:hasValue "comor_diabetes"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :SystemicGeneral ;
            owl:onProperty sulo:refersTo ],
        :YNUQuestion ;
    skos:definition "Defined as a metabolic disorder characterized by abnormally high blood sugar levels due to diminished production of insulin or insulin resistance or desensitization. This includes Type 1 diabetes mellitus, Type 2 diabetes mellitus, or Gestational diabetes (during previous pregnancy) requiring oral or subcutaneous treatment."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4013416>,
        <http://snomed.info/id/73211009> .

<https://w3id.org/arc/arcontology/questions/ComorHypertensi> a owl:Class ;
    rdfs:label "Hypertension"@en ;
    rdfs:comment "Indicate 'Yes', if this is condition existed prior to admission with this current illness and remains an active medical condition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComorbiditiesAndRiskFactorsSection ],
        [ a owl:Restriction ;
            owl:hasValue :Cardiovascular ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "comor_hypertensi"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Defined as elevated arterial blood pressure diagnosed clinically (systolic blood pressure >140mmHg systolic and/or diastolic blood pressure >90mmHg), or for which a patient is prescribed an anti-hypertensive."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0020538>,
        <http://snomed.info/id/38341003> .

<https://w3id.org/arc/arcontology/questions/ComorLiverdisease> a owl:Class ;
    rdfs:label "Liver disease"@en ;
    rdfs:comment "Indicate 'Yes', if this is condition existed prior to admission and is ongoing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "comor_liverdisease"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComorbiditiesAndRiskFactorsSection ],
        [ a owl:Restriction ;
            owl:hasValue :Gastrointestinal ;
            owl:onProperty sulo:refersTo ],
        :YNUQuestion ;
    skos:definition "Defined as any disorder of the hepatobiliary system. Manifestations may include signs and symptoms of cholestasis, portal hypertension, and/or abnormal liver function tests."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0023895>,
        <http://snomed.info/id/235856003> .

<https://w3id.org/arc/arcontology/questions/ComorPrimaryimmuno> a owl:Class ;
    rdfs:label "Primary immunodeficiency"@en ;
    rdfs:comment "Indicate 'Yes', if this is condition existed prior to admission with this current illness and remains an active medical condition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "comor_primaryimmuno"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComorbiditiesAndRiskFactorsSection ],
        [ a owl:Restriction ;
            owl:hasValue :SystemicGeneral ;
            owl:onProperty sulo:refersTo ],
        :YNUQuestion ;
    skos:definition "This refers to immunodeficiency disease that arises independent of another pathologic process, disease, or injury."@en .

<https://w3id.org/arc/arcontology/questions/ComorUnlisted> a owl:Class ;
    rdfs:label "Other relevant comorbidity(s)"@en ;
    rdfs:comment "Indicate 'Yes', if this is condition(s) existed prior to admission with this current illness and remains an active medical condition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OtherBodySystem ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "comor_unlisted"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComorbiditiesAndRiskFactorsSection ],
        :ListQuestionSingle ;
    skos:definition "This refers to a comorbid condition(s) not listed above."@en ;
    skos:exactMatch <http://snomed.info/id/398192003> .

<https://w3id.org/arc/arcontology/questions/ComplAnaemia> a owl:Class ;
    rdfs:label "Anaemia"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this at any time during hospitalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Haematology ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "compl_anaemia"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComplicationsSection ],
        <https://w3id.org/arc/arcontology/questions/Anaemia> ;
    skos:definition "Defined as a reduction in the number of red blood cells, the amount of haemoglobin, and/or the volume of packed red blood cells. Signs and symptoms of anaemia may include pallor of the skin and mucous membranes, shortness of breath, palpitations of the heart, soft systolic murmurs, lethargy, and fatigability. The World Health Organization thresholds are used for defining anaemia, in adult males aged over 15 years anaemia is defined by a haemoglobin <130g/L (<8.1mmol/L); for non-pregnant females aged over 15 years thresholds are <120g/L (<7.4mmol/L), for children aged under 5 years and pregnant women as a haemoglobin <110 g/L (6.8 mmol/L)"@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4229468>,
        <http://snomed.info/id/271737000> .

<https://w3id.org/arc/arcontology/questions/ComplCardiarrhy> a owl:Class ;
    rdfs:label "Cardiac arrhythmia"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this at any time during hospitalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "compl_cardiarrhy"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComplicationsSection ],
        [ a owl:Restriction ;
            owl:hasValue :Cardiovascular ;
            owl:onProperty sulo:refersTo ],
        <https://w3id.org/arc/arcontology/questions/CardiacArrhythmia> ;
    skos:definition "Refers to any variation from the normal rate or rhythm (which may include the origin of the impulse and/or its subsequent propagation) in the heart, confirmed by electrocardiographic monitoring."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C3275765>,
        <http://snomed.info/id/698247007> .

<https://w3id.org/arc/arcontology/questions/ComplJaundice> a owl:Class ;
    rdfs:label "Jaundice"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this at any time during hospitalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "compl_jaundice"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :Gastrointestinal ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComplicationsSection ],
        <https://w3id.org/arc/arcontology/questions/Jaundice> ;
    skos:definition "This refers to a clinical manifestation of hyperbilirubinemia, characterized by the yellowish staining of the skin, mucous membrane and/or sclera."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C3549846>,
        <http://snomed.info/id/18165001> .

<https://w3id.org/arc/arcontology/questions/ComplUnlisted> a owl:Class ;
    rdfs:label "Other complication(s)"@en ;
    rdfs:comment "Specify all other complication(s), not listed above, the patient experienced at any time during hospitalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "compl_unlisted"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :OtherBodySystem ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComplicationsSection ],
        :ListQuestionSingle ;
    skos:definition "This refers to other complication(s) not specified above."@en .

<https://w3id.org/arc/arcontology/questions/ComplUrineret> a owl:Class ;
    rdfs:label "Urinary retention"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this at any time during hospitalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "compl_urineret"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :RenalGenitourinary ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ComplicationsSection ],
        <https://w3id.org/arc/arcontology/questions/UrinaryRetention> ;
    skos:definition "This refers to accumulation of urine within the bladder because of the inability to urinate."@en .

<https://w3id.org/arc/arcontology/questions/CritdCritcare> a owl:Class ;
    rdfs:label "Were advanced care (including acute organ support and critical care) therapeutic interventions administered on this date?"@en ;
    rdfs:comment "Indicate 'Yes', if any advanced care (including acute organ support and critical care) therapeutic intervention(s) or procedure(s) were administered between 00:00 and 24:00 hours on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "critd_critcare"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :AdvancedCareInterventionsSection ],
        :YNUQuestion ;
    skos:definition "This refers to any advanced care (including acute organ support and critical care) therapeutic intervention(s) that were administered between 00:00 and 24:00 hours on day of assessment. This section does not include any respiratory organ support intervention(s), which are recorded seperately."@en .

<https://w3id.org/arc/arcontology/questions/DemogAge> a owl:Class ;
    rdfs:label "Age"@en ;
    rdfs:comment "For participants over the age of two years, please report age in years. For children under the age of two years, please report in months. For neonates below the age of one month, please report in days."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "demog_age"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :DemographicsSection ],
        :NumberQuestion ;
    skos:definition "This refers to the patient's age."@en ;
    skos:exactMatch <http://snomed.info/id/424144002> .

<https://w3id.org/arc/arcontology/questions/DemogAgeUnits> a owl:Class ;
    rdfs:label "Age units"@en ;
    rdfs:comment "Select the most appropriate units for age."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "demog_age_units"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :DemographicsSection ],
        [ a owl:Restriction ;
            owl:hasValue :AgeUnitCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :AgeUnitCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        :ListQuestionSingle ;
    skos:definition "This refers to the patient's age at presentation to the health facility."@en ;
    skos:exactMatch <http://snomed.info/id/424144002> .

<https://w3id.org/arc/arcontology/questions/DemogCalcageDays> a owl:Class ;
    rdfs:label "Calculated Age (days)"@en ;
    rdfs:comment "Age is calculated, if the date of birth is known, as the difference between the date of birth and the most recent date of presentation or admission to the facility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :DemographicsSection ],
        [ a owl:Restriction ;
            owl:hasValue "demog_calcage_days"^^xsd:string ;
            owl:onProperty skos:notation ],
        :NumberQuestion ;
    skos:definition "This refers to the patient's age in days."@en ;
    skos:exactMatch <http://snomed.info/id/424144002> .

<https://w3id.org/arc/arcontology/questions/DemogCountry> a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "Indicate the country of enrolment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :DemographicsSection ],
        [ a owl:Restriction ;
            owl:hasValue "demog_country"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :CountryCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :CountryCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        :ListQuestionSingle ;
    skos:definition "This refers to the country of enrolment"@en .

<https://w3id.org/arc/arcontology/questions/DemogSex> a owl:Class ;
    rdfs:label "Sex at birth"@en ;
    rdfs:comment "Select the most appropriate option that represents the physical sexual characteristics at birth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :DemographicsSection ],
        [ a owl:Restriction ;
            owl:hasValue "demog_sex"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :SexAtBirthCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :SexAtBirthCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        :ListQuestionSingle ;
    skos:definition "This refers to the physical sexual characteristics at birth."@en ;
    skos:exactMatch <http://snomed.info/id/281053000> .

<https://w3id.org/arc/arcontology/questions/DemogSexOth> a owl:Class ;
    rdfs:label "Specify other sex at birth"@en ;
    rdfs:comment "If 'Other', specify the physical sexual characteristics at birth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :DemographicsSection ],
        [ a owl:Restriction ;
            owl:hasValue "demog_sex_oth"^^xsd:string ;
            owl:onProperty skos:notation ],
        :DescriptiveQuestion ;
    skos:definition "This refers to the physical sexual characteristics at birth."@en ;
    skos:exactMatch <http://snomed.info/id/281053000> .

<https://w3id.org/arc/arcontology/questions/DiagnPathounlist> a owl:Class ;
    rdfs:label "Other pathogen(s) detected"@en ;
    rdfs:comment "Specify other detected pathogens, not listed above."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :DiagnosisSection ],
        [ a owl:Restriction ;
            owl:hasValue "diagn_pathounlist"^^xsd:string ;
            owl:onProperty skos:notation ],
        :ListQuestionSingle ;
    skos:definition "This refers to the detection of other pathogens, not listed above."@en .

<https://w3id.org/arc/arcontology/questions/Drug14Ivfluid> a owl:Class ;
    rdfs:label "Intravenous (parenteral) fluids"@en ;
    rdfs:comment "Indicate 'Yes' if the patient received intravenous fluids in the 7 days prior to this most recent admission / presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "drug14_ivfluid"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :MedicationPriorToAdmissionSection ],
        <https://w3id.org/arc/arcontology/questions/IntravenousParenteralFluids> ;
    skos:definition "Intravenous (IV) or parenteral fluids are prescribed as a replacement of fluid, electrolytes, calories, vitamins, and other nutritional substances. Intravenous fluids may be used for rehydration, maintenance requirements or resuscitation."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/CL524079>,
        <http://snomed.info/id/354078009> .

<https://w3id.org/arc/arcontology/questions/Expo14ContactSetting> a owl:Class ;
    rdfs:label "Contact setting"@en ;
    rdfs:comment "Select the most appropriate option that represents the contact setting"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ExposureHistorySection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :ContactSettingCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:hasValue :ContactSettingCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "expo14_contact_setting"^^xsd:string ;
            owl:onProperty skos:notation ],
        :ListQuestionMultiple ;
    skos:definition "This refers to the setting of contact with anyone presenting with similar symptoms or with known confirmed case, or with contaminated material from a suspected or confirmed case (e.g. body fluids, objects, bedding etc.)."@en .

<https://w3id.org/arc/arcontology/questions/Expo14Travel> a owl:Class ;
    rdfs:label "Did the patient travel outside of their home region in the past 14 days?"@en ;
    rdfs:comment "Indicate 'Yes', if the patient travelled to another city/town or region, another part of the country or abroad to another country within 14 days before symptoms relating to the current illness began."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "expo14_travel"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :ExposureHistorySection ],
        :YNUQuestion ;
    skos:definition "This refers to travel to another city/town or region, another part of the country or abroad to another country within 14 days before symptoms relating to the current illness began."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0040802>,
        <http://snomed.info/id/129018004> .

<https://w3id.org/arc/arcontology/questions/FollowDate> a owl:Class ;
    rdfs:label "Date of follow up"@en ;
    rdfs:comment "Enter the date of follow up. (Use the format DD/MM/YYYY)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "follow_date"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :FollowUpAssessmentSection ],
        :DateQuestion ;
    skos:definition "This refers to the date of the patient follow-up."@en .

<https://w3id.org/arc/arcontology/questions/FollowOutcome> a owl:Class ;
    rdfs:label "Patient outcome"@en ;
    rdfs:comment "Select the single most appropriate option that represents the patient outcome."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :FollowUpOutcomeCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "follow_outcome"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :FollowUpOutcomeCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :FollowUpAssessmentSection ],
        :ListQuestionSingle ;
    skos:definition "This refers to an assessment of the patient outcome on follow-up."@en .

<https://w3id.org/arc/arcontology/questions/IncluCase> a owl:Class ;
    rdfs:label "Case classification status"@en ;
    rdfs:comment "Select the most appropriate option that represents the status of the case."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :CaseClassificationCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :InclusionCriteriaSection ],
        [ a owl:Restriction ;
            owl:hasValue "inclu_case"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :CaseClassificationCollection ;
            owl:onProperty sulo:refersTo ],
        :ListQuestionSingle ;
    skos:definition "Confirmed refers to a case that is laboratory confirmed and may fulfil the clinical criteria as described in the case definition. Probable refers to a clinically compatible illness that is epidemiologically linked to a confirmed case without laboratory confirmation of infection with pathogen of interest. Suspected refers to a clinically compatible illness without epidemiological link or laboratory confirmation. Discarded refers to a patient with a negative laboratory test and has failed to fulfil the criteria for a suspect, probable or confirmed case."@en .

<https://w3id.org/arc/arcontology/questions/IncluConsent> a owl:Class ;
    rdfs:label "Participant (or their representative) has provided consent to participate in this study."@en ;
    rdfs:comment "Indicate 'Yes' if the patient or their representative has provided their informed consent for participation in this study."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "inclu_consent"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :InclusionCriteriaSection ],
        :ListQuestionSingle ;
    skos:definition "This refers to provision of informed consent by the patient or their representative for participation in this study."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C5702721>,
        <http://snomed.info/id/61861000000100> .

<https://w3id.org/arc/arcontology/questions/IncluConsentDate> a owl:Class ;
    rdfs:label "Date of consent"@en ;
    rdfs:comment "Enter the date on which informed consent was given for the participants inclusion in this study. (Use the format DD/MM/YYYY)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "inclu_consent_date"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :InclusionCriteriaSection ],
        :DateQuestion ;
    skos:definition "This refers to date on which informed consent was given for the participants inclusion in this study."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C2985782> .

<https://w3id.org/arc/arcontology/questions/IncluConsentWho> a owl:Class ;
    rdfs:label "Consent provided by"@en ;
    rdfs:comment "Select the most appropriate option that represents who provided the consent for participation in this study."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :ConsentProviderCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:hasValue :ConsentProviderCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :InclusionCriteriaSection ],
        [ a owl:Restriction ;
            owl:hasValue "inclu_consent_who"^^xsd:string ;
            owl:onProperty skos:notation ],
        :ListQuestionSingle ;
    skos:definition "This refers to who provided the consent for participation in this study."@en .

<https://w3id.org/arc/arcontology/questions/IncluConsentdes> a owl:Class ;
    rdfs:label "Consent:"@en ;
    rdfs:comment "Consent:"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :InclusionCriteriaSection ],
        [ a owl:Restriction ;
            owl:hasValue "inclu_consentdes"^^xsd:string ;
            owl:onProperty skos:notation ],
        :DescriptiveQuestion .

<https://w3id.org/arc/arcontology/questions/IncluDisease> a owl:Class ;
    rdfs:label "Suspected or confirmed infection, condition, or clinical syndrom"@en ;
    rdfs:comment "If more than one infection is suspected, select the most likely and complete the PATHOGEN TESTING section with laboratory confirmation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :InclusionCriteriaSection ],
        [ a owl:Restriction ;
            owl:hasValue :DiseaseCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :DiseaseCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:hasValue "inclu_disease"^^xsd:string ;
            owl:onProperty skos:notation ],
        :ListQuestionSingle ;
    skos:definition "This refers to any suspected or confirmed infection(s)."@en .

<https://w3id.org/arc/arcontology/questions/IncluReason> a owl:Class ;
    rdfs:label "Is the suspected or confirmed infection, condition, or clinical syndrome the primary reason for hospital admission?"@en ;
    rdfs:comment "Indicate 'Yes' if suspected or confirmed infection with the pathogen of interest if the reason (indication) for the hospital admission. Indicate 'No' if the suspected or confirmed infection with the pathogen of interest is not the reason (indication) for hospital admission."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "inclu_reason"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :InclusionCriteriaSection ],
        :YNUQuestion ;
    skos:definition "This refers to whether suspected or confirmed infection with the pathogen of interest if the reason (indication) for the hospital admission."@en .

<https://w3id.org/arc/arcontology/questions/InterIvfluid> a owl:Class ;
    rdfs:label "Intravenous (parenteral) fluids"@en ;
    rdfs:comment "Indicate 'Yes', if the patient received intravenous fluids at any time during hospitalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :InterventionsSection ],
        [ a owl:Restriction ;
            owl:hasValue "inter_ivfluid"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/IntravenousParenteralFluids> ;
    skos:definition "This refers to intravenous fluid which includes crystalloid, albumin, gelatin, starches or other solutions."@en .

<https://w3id.org/arc/arcontology/questions/InterSuppleo2> a owl:Class ;
    rdfs:label "Any supplemental oxygen?"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced was given or prescribed supplemental oxygen therapy at any time during hospitalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :RespiratorySupportOutcomeSection ],
        [ a owl:Restriction ;
            owl:hasValue "inter_suppleo2"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "This refers to any method of supplemental oxygen therapy that may be delivered via nose cannula, mask or non-invasive or invasive ventilation."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0428648>,
        <http://snomed.info/id/250774007> .

<https://w3id.org/arc/arcontology/questions/InterSuppleo2Dur> a owl:Class ;
    rdfs:label "Number of calendar days the patient received any respiratory support during admission"@en ;
    rdfs:comment "Write the total number of calendar days the patient received this respiratory support during admission (includes use at any time during admission)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :RespiratorySupportOutcomeSection ],
        [ a owl:Restriction ;
            owl:hasValue "inter_suppleo2_dur"^^xsd:string ;
            owl:onProperty skos:notation ],
        :NumberQuestion ;
    skos:definition "This refers to the total number of calendar days the patient received this respiratory support during admission (includes use at any time during admission)."@en .

<https://w3id.org/arc/arcontology/questions/LabsCreatinine> a owl:Class ;
    rdfs:label "Creatinine"@en ;
    rdfs:comment "Write the serum creatinine"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :RenalProfile ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "labs_creatinine"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :LaboratoryResultsSection ],
        :NumberQuestion ;
    skos:definition "This refers to creatinine level in blood."@en .

<https://w3id.org/arc/arcontology/questions/LabsCrp> a owl:Class ;
    rdfs:label "C-reactive protein / CRP"@en ;
    rdfs:comment "Write the CRP."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "labs_crp"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :InflammatoryMarkers ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :LaboratoryResultsSection ],
        :NumberQuestion ;
    skos:definition "C-reactive protein or CRP refers to the serum CRP."@en .

<https://w3id.org/arc/arcontology/questions/LabsHaemoGl> a owl:Class ;
    rdfs:label "Haemoglobin (g/L)"@en ;
    rdfs:comment "Write haemoglobin concentration level (g/L). If there are multiple, report the measure furthest from the normal physiological or laboratory range between 00:00 and 24:00 hours on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :LaboratoryResultsSection ],
        [ a owl:Restriction ;
            owl:hasValue :FullBloodCount ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "labs_haemo_gl"^^xsd:string ;
            owl:onProperty skos:notation ],
        :NumberQuestion ;
    skos:definition "Refers to the haemoglobin concentration in blood."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0518015>,
        <http://snomed.info/id/250220000> .

<https://w3id.org/arc/arcontology/questions/LabsPlatelets> a owl:Class ;
    rdfs:label "Platelets"@en ;
    rdfs:comment "Write the platelet count. If there are multiple, report the measure furthest from the normal physiological or laboratory range between 00:00 and 24:00 hours on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "labs_platelets"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :FullBloodCount ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :LaboratoryResultsSection ],
        :NumberQuestion ;
    skos:definition "Refers to the platelet count in blood."@en .

<https://w3id.org/arc/arcontology/questions/LabsWbccount> a owl:Class ;
    rdfs:label "White blood cell (WBC) count (10^9/L)"@en ;
    rdfs:comment "Write the total white blood cell (WBC) count (10^9/L). If there are multiple, report the measure furthest from the normal physiological or laboratory range between 00:00 and 24:00 hours on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :FullBloodCount ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :LaboratoryResultsSection ],
        [ a owl:Restriction ;
            owl:hasValue "labs_wbccount"^^xsd:string ;
            owl:onProperty skos:notation ],
        :NumberQuestion ;
    skos:definition "Refers to the total white blood cell count in blood."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0023508>,
        <http://snomed.info/id/767002> .

<https://w3id.org/arc/arcontology/questions/MediFrequency> a owl:Class ;
    rdfs:label "Frequency"@en ;
    rdfs:comment "Indicate the frequency of specified medicine administration in a 24-hour period (00:00 to 24:00 hours). Examples include 'every 4 hours', 'twice daily' etc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :MedicationSection ],
        [ a owl:Restriction ;
            owl:hasValue "medi_frequency"^^xsd:string ;
            owl:onProperty skos:notation ],
        :DescriptiveQuestion ;
    skos:definition "Refers to the frequency of specified medicine administration in a 24-hour period (00:00 to 24:00 hours). Examples include 'every 4 hours', 'twice daily' etc."@en .

<https://w3id.org/arc/arcontology/questions/MediMedstartdate> a owl:Class ;
    rdfs:label "Date medication started / first dose"@en ;
    rdfs:comment "Enter the date when the medication was started / first dose was given. (Use the format DD/MM/YYYY)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "medi_medstartdate"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :MedicationSection ],
        :DateQuestion ;
    skos:definition "This refers to the date the medication was started / first dose was administered."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C5236155> .

<https://w3id.org/arc/arcontology/questions/MediMedtype> a owl:Class ;
    rdfs:label "Select agents administered while hospitalised or at discharge (one form per medication)"@en ;
    rdfs:comment "Indicate the type of agent, for all medications administered any time during the patient's admission in the clinical facility (hospital), including in the emergency department, and prescribed on discharge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "medi_medtype"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :MedicationTypeCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:hasValue :MedicationTypeCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :MedicationSection ],
        :ListQuestionSingle ;
    skos:definition "This refers to all medications administered any time during the patient's admission in the clinical facility (hospital), including in the emergency department, and prescribed on discharge."@en .

<https://w3id.org/arc/arcontology/questions/MediRoute> a owl:Class ;
    rdfs:label "Medication route"@en ;
    rdfs:comment "Select the single most appropriate option which represents the route of administration of the medication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :MedicationSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :MedicationRouteCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:hasValue :MedicationRouteCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "medi_route"^^xsd:string ;
            owl:onProperty skos:notation ],
        :ListQuestionSingle ;
    skos:definition "This refers ot the route of administration of the medication."@en .

<https://w3id.org/arc/arcontology/questions/MediUnits> a owl:Class ;
    rdfs:label "Units"@en ;
    rdfs:comment "Write the units of the dosage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :MedicationSection ],
        [ a owl:Restriction ;
            owl:hasValue "medi_units"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :MedicationDoseUnitCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:hasValue :MedicationDoseUnitCollection ;
            owl:onProperty sulo:refersTo ],
        :ListQuestionSingle ;
    skos:definition "This refers to the dosage of the medication administered any time during the patient's admission in the clinical facility (hospital), including in the emergency department, and prescribed on discharge."@en .

<https://w3id.org/arc/arcontology/questions/NbornAnaemia> a owl:Class ;
    rdfs:label "Anaemia"@en ;
    rdfs:comment "Anaemia"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :NewbornSignsAndSymptomsSection ],
        [ a owl:Restriction ;
            owl:hasValue "nborn_anaemia"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/Anaemia> ;
    skos:definition "This refers to a reduction in the number of red blood cells, the amount of haemoglobin, and/or the volume of packed red blood cells relative to neonatal reference ranges."@en .

<https://w3id.org/arc/arcontology/questions/NbornApnoea> a owl:Class ;
    rdfs:label "Apnoea"@en ;
    rdfs:comment "Apnoea"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :NewbornSignsAndSymptomsSection ],
        [ a owl:Restriction ;
            owl:hasValue "nborn_apnoea"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/Apnoea> ;
    skos:definition "Defined as a transient absence in spontaneous respiration."@en .

<https://w3id.org/arc/arcontology/questions/NbornConjunctiv> a owl:Class ;
    rdfs:label "Conjunctivitis"@en ;
    rdfs:comment "Conjunctivitis"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "nborn_conjunctiv"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :NewbornSignsAndSymptomsSection ],
        <https://w3id.org/arc/arcontology/questions/Conjunctivitis> ;
    skos:definition "Defined as inflammation of the conjunctiva"@en .

<https://w3id.org/arc/arcontology/questions/NbornDiarrhoea> a owl:Class ;
    rdfs:label "Diarrhoea"@en ;
    rdfs:comment "Diarrhoea"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :NewbornSignsAndSymptomsSection ],
        [ a owl:Restriction ;
            owl:hasValue "nborn_diarrhoea"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/Diarrhoea> ;
    skos:definition "In neonates, diarrhoea refers to a change in stool frequency or consistency compared with the infant’s normal pattern."@en .

<https://w3id.org/arc/arcontology/questions/NbornJaund> a owl:Class ;
    rdfs:label "Jaundice"@en ;
    rdfs:comment "Jaundice"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "nborn_jaund"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :NewbornSignsAndSymptomsSection ],
        <https://w3id.org/arc/arcontology/questions/Jaundice> ;
    skos:definition "Defined as a clinical manifestation of hyperbilirubinemia, characterized by the yellowish staining of the skin, mucous membrane and/or sclera."@en .

<https://w3id.org/arc/arcontology/questions/NbornSkinpallor> a owl:Class ;
    rdfs:label "Skin pallor"@en ;
    rdfs:comment "Skin pallor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :NewbornSignsAndSymptomsSection ],
        [ a owl:Restriction ;
            owl:hasValue "nborn_skinpallor"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/SkinPallor> ;
    skos:definition "This refers to unnatural pale appearance of the skin."@en .

<https://w3id.org/arc/arcontology/questions/NbornVomit> a owl:Class ;
    rdfs:label "Vomiting"@en ;
    rdfs:comment "Vomiting"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :NewbornSignsAndSymptomsSection ],
        [ a owl:Restriction ;
            owl:hasValue "nborn_vomit"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/Vomiting> ;
    skos:definition "Defined as the expulsion of the stomach or small intestines through the mouth."@en .

<https://w3id.org/arc/arcontology/questions/OutcoDate> a owl:Class ;
    rdfs:label "Outcome date"@en ;
    rdfs:comment "Enter the date of the outcome. (Use the format DD/MM/YYYY)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "outco_date"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :OutcomeSection ],
        :DateQuestion ;
    skos:definition "This refers to the date of the outcome."@en .

<https://w3id.org/arc/arcontology/questions/OutcoOutcome> a owl:Class ;
    rdfs:label "Outcome"@en ;
    rdfs:comment "Select the outcome that is true on the outcome date. Palliative care includes palliative discharge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :OutcomeSection ],
        [ a owl:Restriction ;
            owl:hasValue "outco_outcome"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :HospitalOutcomeCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :HospitalOutcomeCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        :ListQuestionSingle ;
    skos:definition "This refers to the outcome."@en .

<https://w3id.org/arc/arcontology/questions/PregGeswek> a owl:Class ;
    rdfs:label "Gestational weeks at presentation"@en ;
    rdfs:comment "Indicate the estimated gestational age of the foetus (in weeks)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "preg_geswek"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :PregnancyPresentationSection ],
        :NumberQuestion ;
    skos:definition "This refers to the gestational age of the foetus (written in weeks). It can be calculated from the woman's last menstrual period (LMP) or calculated using the best obstetrical estimated due date (EDD) based on the following formula: Gestational Age = (280 - (EDD - Reference Date)). The reference date is the date in which you are trying to determine the gestational age."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/CL1385889>,
        <http://snomed.info/id/57036006> .

<https://w3id.org/arc/arcontology/questions/PregPostpartum> a owl:Class ;
    rdfs:label "Post-partum (within 6 weeks of delivery)"@en ;
    rdfs:comment "Indicate 'Yes', if the patient is in post-partum period (within 6 weeks of delivery)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "preg_postpartum"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :PregnancyPresentationSection ],
        :YNUQuestion ;
    skos:definition "This refers to the temporal period relating to mother from completion of labour until six weeks post-delivery."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0086839>,
        <http://snomed.info/id/86569001> .

<https://w3id.org/arc/arcontology/questions/PregPregnant> a owl:Class ;
    rdfs:label "Pregnant"@en ;
    rdfs:comment "Indicate 'Yes', if the patient is pregnant at presentation. If the patient is of fertile age with no negative pregnancy test select 'Unknown'."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "preg_pregnant"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :PregnancyPresentationSection ],
        :YNUQuestion ;
    skos:definition "This refers to women who reports to be pregnant at presentation and/or have had a positive pregnancy test in recent days prior to presentation."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0549206>,
        <http://snomed.info/id/77386006> .

<https://w3id.org/arc/arcontology/questions/PresAdm> a owl:Class ;
    rdfs:label "Admitted to hospital"@en ;
    rdfs:comment "Indicate 'Yes', if that patient was admitted to your site."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "pres_adm"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :OnsetAndPresentationSection ],
        :YNUQuestion ;
    skos:definition "This refers to admission of the patient to your site for the current illness."@en ;
    skos:exactMatch <http://snomed.info/id/32485007> .

<https://w3id.org/arc/arcontology/questions/PresAdmTime> a owl:Class ;
    rdfs:label "Time of hospital admission"@en ;
    rdfs:comment "Enter the time of admission to your site. (Use 24-hour format (00:00 - 24:00 hours))"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "pres_adm_time"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :OnsetAndPresentationSection ],
        :DateQuestion ;
    skos:definition "This refers to admission of the patient to your site for the current illness."@en .

<https://w3id.org/arc/arcontology/questions/PresDate> a owl:Class ;
    rdfs:label "Most recent presentation/admission date at this facility"@en ;
    rdfs:comment "Enter the date of hospitalisation / admission to your site. (Use the format DD/MM/YYYY)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :OnsetAndPresentationSection ],
        [ a owl:Restriction ;
            owl:hasValue "pres_date"^^xsd:string ;
            owl:onProperty skos:notation ],
        :DateQuestion ;
    skos:definition "This refers to the date of hospitalisation / admission of the patient to your site for the current illness."@en ;
    skos:exactMatch <http://snomed.info/id/32485007> .

<https://w3id.org/arc/arcontology/questions/PresFirstsym> a owl:Class ;
    rdfs:label "Symptom(s) during first 24 hours of illness (select all that apply)"@en ;
    rdfs:comment "Select all symptoms which the patient experienced during the first 24 hours of illness (select all that apply)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :OnsetAndPresentationSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :SymptomCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:hasValue :SymptomCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "pres_firstsym"^^xsd:string ;
            owl:onProperty skos:notation ],
        :ListQuestionMultiple ;
    skos:definition "This refers to the first symptom, or symptoms (if multiple occurred at the same time), that you clinically believe was related to this episode of illness."@en .

<https://w3id.org/arc/arcontology/questions/PresOnsetdate> a owl:Class ;
    rdfs:label "Onset date of first / earliest symptom"@en ;
    rdfs:comment "Enter the date of the first symptom that you clinically believe was related to this episode of illness. (Use the format DD/MM/YYYY)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :OnsetAndPresentationSection ],
        [ a owl:Restriction ;
            owl:hasValue "pres_onsetdate"^^xsd:string ;
            owl:onProperty skos:notation ],
        :DateQuestion ;
    skos:definition "This refers to the date of onset of the first / earliest symptom which is clinically related to the current episode of illness."@en ;
    skos:exactMatch <http://snomed.info/id/405795006> .

<https://w3id.org/arc/arcontology/questions/PresSymptpres> a owl:Class ;
    rdfs:label "Symptomatic at initial presentation?"@en ;
    rdfs:comment "Indicate 'Yes', if the patient was symptomatic at the initial presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :OnsetAndPresentationSection ],
        [ a owl:Restriction ;
            owl:hasValue "pres_symptpres"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "This refers to whether the patient was symptomatic at the initial presentation."@en .

<https://w3id.org/arc/arcontology/questions/SignAnaemia> a owl:Class ;
    rdfs:label "Anaemia"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "sign_anaemia"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :Haematology ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsSection ],
        <https://w3id.org/arc/arcontology/questions/Anaemia> ;
    skos:definition "This refers to a reduction in the number of red blood cells, the amount of hemoglobin, and/or the volume of packed red blood cells. Common manifestations include pallor, fatigue, dizziness, shortness of breath, and tachycardia."@en .

<https://w3id.org/arc/arcontology/questions/SignApnoea> a owl:Class ;
    rdfs:label "Apnoea"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Respiratory ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "sign_apnoea"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsSection ],
        <https://w3id.org/arc/arcontology/questions/Apnoea> ;
    skos:definition "Defined as a transient absence in spontaneous respiration."@en .

<https://w3id.org/arc/arcontology/questions/SignArrhythmia> a owl:Class ;
    rdfs:label "Cardiac arrhythmia"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Cardiovascular ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsSection ],
        [ a owl:Restriction ;
            owl:hasValue "sign_arrhythmia"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/CardiacArrhythmia> ;
    skos:definition "Refers to an abnormality in rhythm of heartbeat, including rate, regularity, and/or sequence of activation abnormalities"@en .

<https://w3id.org/arc/arcontology/questions/SignConjunctiv> a owl:Class ;
    rdfs:label "Conjunctivitis"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsSection ],
        [ a owl:Restriction ;
            owl:hasValue "sign_conjunctiv"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :Ocular ;
            owl:onProperty sulo:refersTo ],
        <https://w3id.org/arc/arcontology/questions/Conjunctivitis> ;
    skos:definition "Defined as inflammation of the conjunctiva"@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4011653> .

<https://w3id.org/arc/arcontology/questions/SignJaund> a owl:Class ;
    rdfs:label "Jaundice"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Gastrointestinal ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SignsSection ],
        [ a owl:Restriction ;
            owl:hasValue "sign_jaund"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/Jaundice> ;
    skos:definition "Defined as a clinical manifestation of hyperbilirubinemia, characterized by the yellowish staining of the skin, mucous membrane and/or sclera."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C3549846> .

<https://w3id.org/arc/arcontology/questions/Subjid> a owl:Class ;
    rdfs:label "Participant Identification Number (PIN)"@en ;
    rdfs:comment "Write the Participant Identification Number (PIN)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "subjid"^^xsd:string ;
            owl:onProperty skos:notation ],
        :DescriptiveQuestion ;
    skos:definition "The Participant Identification Number or PIN is a unique number used to identify the patient's (participant's) data."@en .

<https://w3id.org/arc/arcontology/questions/SymptDiarrhoea> a owl:Class ;
    rdfs:label "Diarrhoea"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Gastrointestinal ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "sympt_diarrhoea"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsSection ],
        <https://w3id.org/arc/arcontology/questions/Diarrhoea> ;
    skos:definition "Defined as three or more loose or liquid bowel movement per day (or more frequent passage than is normal for the individual)."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C3554472> .

<https://w3id.org/arc/arcontology/questions/SymptDn4Notes> a owl:Class ;
    rdfs:label "Clinical notes (optional)"@en ;
    rdfs:comment "Clinical notes (optional)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "sympt_dn4_notes"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsSection ],
        :DescriptiveQuestion .

<https://w3id.org/arc/arcontology/questions/SymptSkinpallor> a owl:Class ;
    rdfs:label "Skin pallor"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :SystemicGeneral ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "sympt_skinpallor"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsSection ],
        <https://w3id.org/arc/arcontology/questions/SkinPallor> ;
    skos:definition "This refers to unnatural pale appearance of the skin."@en .

<https://w3id.org/arc/arcontology/questions/SymptUrine> a owl:Class ;
    rdfs:label "Urinary retention"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "sympt_urine"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsSection ],
        [ a owl:Restriction ;
            owl:hasValue :Genitourinary ;
            owl:onProperty sulo:refersTo ],
        <https://w3id.org/arc/arcontology/questions/UrinaryRetention> ;
    skos:definition "Defined as the accumulation of urine within the bladder because of the inability to urinate."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0080274> .

<https://w3id.org/arc/arcontology/questions/SymptVomit> a owl:Class ;
    rdfs:label "Vomiting"@en ;
    rdfs:comment "Indicate 'Yes', if the patient experienced this between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Gastrointestinal ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "sympt_vomit"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :SymptomsSection ],
        <https://w3id.org/arc/arcontology/questions/Vomiting> ;
    skos:definition "Defined as the expulsion of the stomach or small intestines through the mouth."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4230730> .

<https://w3id.org/arc/arcontology/questions/TestPathtested> a owl:Class ;
    rdfs:label "Pathogen tested / detected"@en ;
    rdfs:comment "Indicate the pathogen(s) which were tested for using the biological sample."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :PathogenTestingSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :PathogenCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:hasValue "test_pathtested"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :PathogenCollection ;
            owl:onProperty sulo:refersTo ],
        :ListQuestionSingle ;
    skos:definition "This refers to the pathogen(s) tested for using the biological sample."@en .

<https://w3id.org/arc/arcontology/questions/TestResult> a owl:Class ;
    rdfs:label "Pathogen test result"@en ;
    rdfs:comment "Select the single most appropriate option that represents results of the pathogen(s) tested for using the biological sample."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :PathogenTestResultCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :PathogenTestingSection ],
        [ a owl:Restriction ;
            owl:hasValue :PathogenTestResultCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:hasValue "test_result"^^xsd:string ;
            owl:onProperty skos:notation ],
        :ListQuestionSingle ;
    skos:definition "This refers to the results of the pathogen(s) tested for using the biological sample."@en .

<https://w3id.org/arc/arcontology/questions/TreatFluidParent> a owl:Class ;
    rdfs:label "Intravenous (parenteral) fluids"@en ;
    rdfs:comment "Indicate 'Yes', if the patient received intravenous fluids between 00:00 and 24:00 hours on the day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :TreatmentsAndInterventionsSection ],
        [ a owl:Restriction ;
            owl:hasValue "treat_fluid_parent"^^xsd:string ;
            owl:onProperty skos:notation ],
        <https://w3id.org/arc/arcontology/questions/IntravenousParenteralFluids> ;
    skos:definition "This refers to intravenous fluids, adminstered via a central or peripheral catheter into the venous system, for fluid resuscitation or replacement of electrolytes, calories, vitamins, or other medical reasons. Examples: 0.9% Sodium Chloride (Normal Saline), 5% Glucose (Dextrose 5% in Water), Albumin etc."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C2735346>,
        <http://snomed.info/id/118431008> .

<https://w3id.org/arc/arcontology/questions/TreatImv> a owl:Class ;
    rdfs:label "Invasive ventilation"@en ;
    rdfs:comment "Indicate 'Yes', if this mode of respiratory support was used to deliver supplemental oxygen to the patient between 00:00 and 24:00 hours on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "treat_imv"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :RespiratorySupportSection ],
        :YNUQuestion ;
    skos:definition "Thsi refers to invasive mechanical ventilation (IMV) which indicates that patient has undergone tracheal intubation, to mechanically assist or replace spontaneous breathing in patients by use of a powered device that forces oxygenated air into the lungs. The mode of intubation may be orotracheal, nasotracheal, or via a cricothyrotomy or tracheotomy."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C1868981>,
        <http://snomed.info/id/1258985005> .

<https://w3id.org/arc/arcontology/questions/VacciCovid19> a owl:Class ;
    rdfs:label "Vaccinated for COVID-19 (ever)"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has ever received a vaccine targetted against SARS-Cov-2"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "vacci_covid19"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :VaccinationSection ],
        :YNUQuestion ;
    skos:definition "Ever received a vaccine targeted against SARS-Cov-2. Examples include Spikevax (Moderna), Comirnaty (Pfizer/BioNTech), Nuvaxovid (Novavax), Vaxzevria (AstraZeneca/Oxford), Janssen COVID-19 Vaccine (Johnson & Johnson), Valneva (Valneva)."@en .

<https://w3id.org/arc/arcontology/questions/VacciCovid19Date1> a owl:Class ;
    rdfs:label "Date of first COVID-19 vaccine"@en ;
    rdfs:comment "Enter the date of first COVID-19 vaccine. If the precise date is unknown, enter an estimate. (Use the format DD/MM/YYYY)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :VaccinationSection ],
        [ a owl:Restriction ;
            owl:hasValue "vacci_covid19_date1"^^xsd:string ;
            owl:onProperty skos:notation ],
        :DateQuestion ;
    skos:definition "This refers to the date on which the first dose of COVID-19 vaccine was received in the format DD/MM/YYYY.  If precise date unknown, estimate."@en .

<https://w3id.org/arc/arcontology/questions/VitalHighesttem> a owl:Class ;
    rdfs:label "Highest temperature"@en ;
    rdfs:comment "Enter the highest peripheral body temperature recorded between 00:00 and 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :VitalSignsAndAssessmentsSection ],
        [ a owl:Restriction ;
            owl:hasValue "vital_highesttem"^^xsd:string ;
            owl:onProperty skos:notation ],
        :NumberQuestion ;
    skos:definition "Refers to the highest peripheral body temperature (rectal if <3 months) between 00:00 and 24:00 on day of assessment."@en .

<https://w3id.org/arc/arcontology/questions/VitalHighesttemUnits> a owl:Class ;
    rdfs:label "Highest temperature (select units)"@en ;
    rdfs:comment "Highest temperature (select units)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "vital_highesttem_units"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:hasValue :TemperatureUnitCollection ;
            owl:onProperty sulo:refersTo ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AnswerOption [ a owl:Restriction ;
                                owl:hasValue :TemperatureUnitCollection ;
                                owl:onProperty sulo:isItemIn ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :VitalSignsAndAssessmentsSection ],
        :ListQuestionSingle .

<https://w3id.org/arc/arcontology/questions/VitalHr> a owl:Class ;
    rdfs:label "Heart Rate (bpm)"@en ;
    rdfs:comment "Enter the heart rate measured in beats per minute. Record the value furthest from normal range between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :VitalSignsAndAssessmentsSection ],
        [ a owl:Restriction ;
            owl:hasValue "vital_hr"^^xsd:string ;
            owl:onProperty skos:notation ],
        :NumberQuestion ;
    skos:definition "Refers to heart rate measured in beats per minute. This may be measured manually or by electronic monitoring."@en .

<https://w3id.org/arc/arcontology/questions/VitalRr> a owl:Class ;
    rdfs:label "Respiratory Rate (breaths/min)"@en ;
    rdfs:comment "Enter the respiratory rate measured in breaths per minute. Record the value furthest from normal range between 00:00 to 24:00 on day of assessment. If both abnormal low and high rate observed, record the abnormally high rate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :VitalSignsAndAssessmentsSection ],
        [ a owl:Restriction ;
            owl:hasValue "vital_rr"^^xsd:string ;
            owl:onProperty skos:notation ],
        :NumberQuestion ;
    skos:definition "Refers to respiratory rate in breaths per minute. Manual rather than electronic measurement is preferred where possible (this is achieved by counting the number of breaths for one minute, counting how many times the chest rises within this time period).  If both abnormal low and high rate observed, record the abnormally high rate."@en .

<https://w3id.org/arc/arcontology/questions/VitalSpo2room> a owl:Class ;
    rdfs:label "Oxygen saturation at room air (no oxygen support) (%)"@en ;
    rdfs:comment "Indicate the measurement of oxygen saturation at room air with no oxygen support."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :VitalSignsAndAssessmentsSection ],
        [ a owl:Restriction ;
            owl:hasValue "vital_spo2room"^^xsd:string ;
            owl:onProperty skos:notation ],
        :NumberQuestion ;
    skos:definition "This refers to the measurement of the ratio of oxygenated hemoglobin to total hemoglobin in the blood, measured at room air with no oxygen support."@en .

<https://w3id.org/arc/arcontology/questions/VitalSystolicbp> a owl:Class ;
    rdfs:label "Systolic BP (mmHg)"@en ;
    rdfs:comment "Enter the systolic blood pressure measured in millimetres of mercury (mmHg). Record the systolic blood pressure from the observation with the lowest mean arterial pressure (MAP) (if mean arterial pressure has not been calculated, report the measurement with lowest systolic blood pressure) that occurred between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "vital_systolicbp"^^xsd:string ;
            owl:onProperty skos:notation ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isPartOf ;
            owl:someValuesFrom :VitalSignsAndAssessmentsSection ],
        :NumberQuestion ;
    skos:definition "This refers to the systolic blood pressure from the observation with the lowest mean arterial pressure (if mean arterial pressure has not been calculated, report the measurement with lowest systolic blood pressure).  For example, if the blood pressure is 120/85 mmHg, enter 120 in the section marked 'systolic BP'."@en .

:ARCCRF a owl:Class ;
    rdfs:label "ARC CRF"@en ;
    rdfs:comment "A specialized Case Report Form that is associated with and constrained by the specifications of a distinct ARC research protocol."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom :ARCQuestion ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom :ARCForm ],
        [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom :SubjectOfCareRole ],
        sulo:InformationObject .

:AbdominalPain a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :SymptomCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "AbdominalPain"@en ;
    sulo:hasValue "Abdominal Pain"^^xsd:string .

:AbnormalWeightLoss a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :SymptomCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "AbnormalWeightLoss"@en ;
    sulo:hasValue "Abnormal Weight Loss"^^xsd:string .

:Achromobacter a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :PathogenCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "Achromobacter"@en ;
    sulo:hasValue "Achromobacter"^^xsd:string .

:AchromobacterXylosoxidans a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :PathogenCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "AchromobacterXylosoxidans"@en ;
    sulo:hasValue "Achromobacter Xylosoxidans"^^xsd:string .

:Acinetobacter a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :PathogenCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "Acinetobacter"@en ;
    sulo:hasValue "Acinetobacter"^^xsd:string .

:AcinetobacterAnitratus a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :PathogenCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "AcinetobacterAnitratus"@en ;
    sulo:hasValue "Acinetobacter Anitratus"^^xsd:string .

:AcinetobacterBaumannii a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :PathogenCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "AcinetobacterBaumannii"@en ;
    sulo:hasValue "Acinetobacter Baumannii"^^xsd:string .

:AcinetobacterCalcoaceticus a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :PathogenCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "AcinetobacterCalcoaceticus"@en ;
    sulo:hasValue "Acinetobacter Calcoaceticus"^^xsd:string .

:AcinetobacterCalcoaceticusBaumanniiComplex a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :PathogenCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "AcinetobacterCalcoaceticusBaumanniiComplex"@en ;
    sulo:hasValue "Acinetobacter Calcoaceticus Baumannii Complex"^^xsd:string .

