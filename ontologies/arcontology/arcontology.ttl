    rdfs:subClassOf :ARCSection .

:ContactSettingCollection a owl:Class ;
    rdfs:label "contact setting answer option collection"@en ;
    rdfs:comment "A collection of the settings in which a contact may have occurred, such as household, community/social, healthcare facility, occupational/workplace, sexual contact, air travel/flight, vertical transmission, other or unknown."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OccupationalWorkplace ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Unknown ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :HealthcareFacility ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :VerticalTransmission ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Other ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :SexualContact ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :AirTravelFlight ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :CommunitySocial ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Household ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:ARCForm a owl:Class ;
    rdfs:label "ARC Form"@en ;
    rdfs:comment "Root class for all ARC CRF forms. Subclasses are defined as equivalent to ARCForm & refersTo some <ProcessClass> to capture which clinical phase each form documents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom sulo:Process ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom :ARCSection ],
        sulo:InformationObject .

:MedicationDoseUnitCollection a owl:Class ;
    rdfs:label "medication dose unit answer option collection"@en ;
    rdfs:comment "A collection of the units in which a medication dose or rate may be expressed, such as mg, g, µg, IU, mg/kg, mg/day, mL, mL/h, %, tablets or other."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Tablets ;
