:AnswerOption a owl:Class ;
    rdfs:label "answer option"@en ;
    rdfs:comment "A named information object representing a selectable answer option."@en ;
    rdfs:subClassOf sulo:InformationObject .

[] a owl:AllDisjointClasses ;
    owl:members ( :YNUQuestion :ListQuestionSingle :ListQuestionMultiple :DateQuestion :NumberQuestion :DescriptiveQuestion ) .

