    rdfs:comment "A question whose answer is a date or datetime, represented as a time instant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom sulo:TimeInstant ],
        :ARCQuestion .

:MedicationRouteCollection a owl:Class ;
    rdfs:label "medication route answer option collection"@en ;
    rdfs:comment "A collection of the routes of administration of a medication: oral, subcutaneous, inhaled, IV, topical, unknown or other."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Other ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Topical ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Oral ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Inhaled ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Unknown ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :IV ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Subcutaneous ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:HospitalOutcomeCollection a owl:Class ;
    rdfs:label "hospital outcome answer option collection"@en ;
    rdfs:comment "A collection of the possible outcomes at the end of the hospital stay or study. ARC list: outcome_Outcome. Its items are added as named individuals in a later notebook."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
