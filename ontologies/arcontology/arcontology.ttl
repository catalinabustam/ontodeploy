            owl:hasValue :AndesVirusInfectionHantavirus ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :JapaneseEncephalitis ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :MiddleEastRespiratorySyndromeMERS ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :HepatitisGeneralUnspecified ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :MarburgVirusDiseaseMVD ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :InfluenzaAH1N1 ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :AvianInfluenzaAH7N9H5N1H5N8H7N7 ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :CommunityAcquiredPneumonia ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
