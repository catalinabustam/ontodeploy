:ExposureHistorySection a owl:Class ;
    rdfs:label "EXPOSURE HISTORY IN PREVIOUS 14 DAYS"@en ;
    rdfs:comment "EXPOSURE HISTORY IN PREVIOUS 14 DAYS"@en ;
    rdfs:subClassOf :ARCSection .

:FollowUpAssessmentSection a owl:Class ;
    rdfs:label "FOLLOW-UP ASSESSMENT"@en ;
    rdfs:comment "FOLLOW-UP ASSESSMENT"@en ;
    rdfs:subClassOf :ARCSection .

:FullBloodCount a owl:Class ;
    rdfs:label "Full Blood Count"@en ;
    rdfs:comment "Full Blood Count"@en ;
    rdfs:subClassOf :BodySystem .

:Haematology a owl:Class ;
    rdfs:label "Haematology"@en ;
    rdfs:comment "Haematology"@en ;
    rdfs:subClassOf :BodySystem .

:ListQuestionMultiple a owl:Class ;
    rdfs:label "list question (multiple choice)"@en ;
    rdfs:comment "A question that allows the selection of one or more items from a list of options."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom :AnswerOptionCollection ],
        :ARCQuestion .

:OutcomeSection a owl:Class ;
    rdfs:label "OUTCOME"@en ;
    rdfs:comment "OUTCOME"@en ;
    rdfs:subClassOf :ARCSection .

:PathogenTestingSection a owl:Class ;
    rdfs:label "PATHOGEN TESTING"@en ;
    rdfs:comment "PATHOGEN TESTING: Results of all types of sample and pathogen testing"@en ;
    rdfs:subClassOf :ARCSection .

:RespiratorySupportOutcomeSection a owl:Class ;
    rdfs:label "RESPIRATORY SUPPORT"@en ;
    rdfs:comment "RESPIRATORY SUPPORT: Record all respiratory interventions given or prescribed from day of presentation to day of discharge / outcome."@en ;
    rdfs:subClassOf :ARCSection .

:VaccinationSection a owl:Class ;
    rdfs:label "VACCINATION"@en ;
    rdfs:comment "VACCINATION"@en ;
    rdfs:subClassOf :ARCSection .

<https://w3id.org/arc/arcontology/questions/Apnoea> a owl:Class ;
    rdfs:label "Apnoea"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsign_apnoea"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Defined as a transient absence in spontaneous respiration."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0003578>,
        <http://snomed.info/id/1023001> .

<https://w3id.org/arc/arcontology/questions/CardiacArrhythmia> a owl:Class ;
    rdfs:label "Cardiac arrhythmia"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsign_arrhythmia"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Refers to an abnormality in rhythm of heartbeat, including rate, regularity, and/or sequence of activation abnormalities"@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0003811>,
        <http://snomed.info/id/698247007> .

<https://w3id.org/arc/arcontology/questions/Conjunctivitis> a owl:Class ;
    rdfs:label "Conjunctivitis"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsign_conjunctiv"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Defined as inflammation of the conjunctiva"@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4011653>,
        <http://snomed.info/id/9826008> .

<https://w3id.org/arc/arcontology/questions/Diarrhoea> a owl:Class ;
    rdfs:label "Diarrhoea"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsym_diarrhoea"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Defined as abnormally increased frequency (usually defined as three or more) loose or liquid bowel movement per day (or more frequent passage than is normal for the individual)."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C3554472>,
        <http://snomed.info/id/62315008> .

<https://w3id.org/arc/arcontology/questions/IntravenousParenteralFluids> a owl:Class ;
    rdfs:label "Intravenous (parenteral) fluids"@en ;
    rdfs:comment "Indicate 'Yes' if the patient received intravenous fluids in the 7 days prior to this most recent admission / presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "drug14_ivfluid"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Intravenous (IV) or parenteral fluids are prescribed as a replacement of fluid, electrolytes, calories, vitamins, and other nutritional substances. Intravenous fluids may be used for rehydration, maintenance requirements or resuscitation."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/CL524079>,
        <http://snomed.info/id/354078009> .

<https://w3id.org/arc/arcontology/questions/SkinPallor> a owl:Class ;
    rdfs:label "Skin pallor"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsym_skinpallor"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "This refers to unnatural pale appearance of the skin."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0241137> .

<https://w3id.org/arc/arcontology/questions/UrinaryRetention> a owl:Class ;
    rdfs:label "Urinary retention"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsym_urine"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Defined as the accumulation of urine within the bladder because of the inability to urinate."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0080274>,
        <http://snomed.info/id/267064002> .

<https://w3id.org/arc/arcontology/questions/Vomiting> a owl:Class ;
    rdfs:label "Vomiting"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsym_vomit"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Defined as the expulsion of the stomach or small intestines through the mouth."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C4230730>,
        <http://snomed.info/id/422400008> .

:Cardiovascular a owl:Class ;
    rdfs:label "Cardiovascular"@en ;
    rdfs:comment "Cardiovascular"@en ;
    rdfs:subClassOf :BodySystem .

:Other a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :ContactSettingCollection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :MedicationDoseUnitCollection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :SexAtBirthCollection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :MedicationRouteCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "Other"@en ;
    sulo:hasValue "Other"^^xsd:string .

:PregnancyPresentationSection a owl:Class ;
    rdfs:label "PREGNANCY PRESENTATION"@en ;
    rdfs:comment "PREGNANCY PRESENTATION"@en ;
    rdfs:subClassOf :ARCSection .

:TemperatureUnitCollection a owl:Class ;
    rdfs:label "temperature unit answer option collection"@en ;
    rdfs:comment "A collection of the units in which a temperature may be expressed: degrees Celsius or degrees Fahrenheit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :F ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :C ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:Unknown a [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :PathogenTestResultCollection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :MedicationRouteCollection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :YNUCollection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:isItemIn ;
            owl:someValuesFrom :ContactSettingCollection ],
        owl:NamedIndividual,
        :AnswerOption ;
    rdfs:label "Unknown"@en ;
    sulo:hasValue "Unknown"^^xsd:string .

:YNUCollection a owl:Class ;
    rdfs:label "yes/no/unknown answer option collection"@en ;
    rdfs:comment "A collection of answer options for a yes/no/unknown question."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :No ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Yes ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Unknown ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

<https://w3id.org/arc/arcontology/questions/Anaemia> a owl:Class ;
    rdfs:label "Anaemia"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsign_anaemia"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "This refers to a reduction in the number of red blood cells, the amount of hemoglobin, and/or the volume of packed red blood cells. Common manifestations include pallor, fatigue, dizziness, shortness of breath, and tachycardia."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C0002871>,
        <http://snomed.info/id/271737000> .

<https://w3id.org/arc/arcontology/questions/Jaundice> a owl:Class ;
    rdfs:label "Jaundice"@en ;
    rdfs:comment "Indicate 'Yes', if the patient has experienced this at any time from onset of this illness to presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "adsign_jaund"^^xsd:string ;
            owl:onProperty skos:notation ],
        :YNUQuestion ;
    skos:definition "Defined as a clinical manifestation of hyperbilirubinemia, characterized by the yellowish staining of the skin, mucous membrane and/or sclera."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/UMLS/C3549846>,
        <http://snomed.info/id/18165001> .

:AgeUnitCollection a owl:Class ;
    rdfs:label "age unit answer option collection"@en ;
    rdfs:comment "A collection of the units in which an age may be expressed: years, months or days."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Years ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Days ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Months ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:Respiratory a owl:Class ;
    rdfs:label "Respiratory"@en ;
    rdfs:comment "Respiratory"@en ;
    rdfs:subClassOf :BodySystem .

:ComplicationsSection a owl:Class ;
    rdfs:label "COMPLICATIONS"@en ;
    rdfs:comment "COMPLICATIONS: Experienced at any time from day of presentation to day of discharge / outcome."@en ;
    rdfs:subClassOf :ARCSection .

:ConsentProviderCollection a owl:Class ;
    rdfs:label "consent provider answer option collection"@en ;
    rdfs:comment "A collection of the persons who may provide consent: the participant, a parent/guardian, a consultee or an independent clinician."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Consultee ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :ParentGuardian ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Participant ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :IndependentClinician ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:DescriptiveQuestion a owl:Class ;
    rdfs:label "descriptive question"@en ;
    rdfs:comment "A question whose answer is free text."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasValue ;
            owl:someValuesFrom xsd:string ],
        :ARCQuestion .

:LaboratoryResultsSection a owl:Class ;
    rdfs:label "LABORATORY RESULTS"@en ;
    rdfs:comment "LABORATORY RESULTS: Record the value furthest from normal range between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf :ARCSection .

:MedicationSection a owl:Class ;
    rdfs:label "MEDICATION"@en ;
    rdfs:comment "MEDICATION: Record medications administered or prescribed from day of presentation to day of discharge / outcome (one form per medication)."@en ;
    rdfs:subClassOf :ARCSection .

:PathogenTestResultCollection a owl:Class ;
    rdfs:label "pathogen test result answer option collection"@en ;
    rdfs:comment "A collection of the possible results of a pathogen test: detected, not detected, equivocal or unknown."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Unknown ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :NotDetected ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Detected ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Equivocal ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:SexAtBirthCollection a owl:Class ;
    rdfs:label "sex at birth answer option collection"@en ;
    rdfs:comment "A collection of the possible values of sex at birth: male, female, not specified/unknown or other."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Other ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Female ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Male ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :NotSpecifiedUnknown ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:SignsOnAdmissionSection a owl:Class ;
    rdfs:label "SIGNS ON ADMISSION"@en ;
    rdfs:comment "SIGNS ON ADMISSION: Indicate if experienced at any time from onset of this illness to the day of presentation."@en ;
    rdfs:subClassOf :ARCSection .

:SignsSection a owl:Class ;
    rdfs:label "SIGNS"@en ;
    rdfs:comment "SIGNS: Record the clinical findings observed between 00:00 and 24:00 on the day of assessment"@en ;
    rdfs:subClassOf :ARCSection .

:SymptomsSection a owl:Class ;
    rdfs:label "SYMPTOMS"@en ;
    rdfs:comment "SYMPTOMS: Indicate if experienced between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf :ARCSection .

:SystemicGeneral a owl:Class ;
    rdfs:label "Systemic/General"@en ;
    rdfs:comment "Systemic/General"@en ;
    rdfs:subClassOf :BodySystem .

:CaseClassificationCollection a owl:Class ;
    rdfs:label "case classification answer option collection"@en ;
    rdfs:comment "A collection of the possible classification statuses of a case: confirmed, probable, suspected, discarded or error."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Suspected ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Error ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Discarded ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Probable ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Confirmed ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:DemographicsSection a owl:Class ;
    rdfs:label "DEMOGRAPHICS"@en ;
    rdfs:comment "DEMOGRAPHICS"@en ;
    rdfs:subClassOf :ARCSection .

:NewbornSignsAndSymptomsSection a owl:Class ;
    rdfs:label "NEWBORN SIGNS AND SYMPTOMS"@en ;
    rdfs:comment "NEWBORN SIGNS AND SYMPTOMS"@en ;
    rdfs:subClassOf :ARCSection .

:OnsetAndPresentationSection a owl:Class ;
    rdfs:label "ONSET & PRESENTATION"@en ;
    rdfs:comment "ONSET & PRESENTATION"@en ;
    rdfs:subClassOf :ARCSection .

:VitalSignsAndAssessmentsSection a owl:Class ;
    rdfs:label "VITAL SIGNS & ASSESSMENTS"@en ;
    rdfs:comment "VITAL SIGNS & ASSESSMENTS: Record the value furthest from normal range between 00:00 to 24:00 on day of assessment."@en ;
    rdfs:subClassOf :ARCSection .

:ARCQuestion a owl:Class ;
    rdfs:label "ARC Question"@en ;
    rdfs:comment "Completion Guideline: How to fill the field in practice."@en ;
    rdfs:subClassOf sulo:InformationObject ;
    skos:definition "Formal definition — what the variable measures"@en .

:ComorbiditiesAndRiskFactorsSection a owl:Class ;
    rdfs:label "CO-MORBIDITIES AND RISK FACTORS"@en ;
    rdfs:comment "CO-MORBIDITIES AND RISK FACTORS: Existing prior to this current illness and is ongoing"@en ;
    rdfs:subClassOf :ARCSection .

:Gastrointestinal a owl:Class ;
    rdfs:label "Gastrointestinal"@en ;
    rdfs:comment "Gastrointestinal"@en ;
    rdfs:subClassOf :BodySystem .

:InclusionCriteriaSection a owl:Class ;
    rdfs:label "INCLUSION CRITERIA"@en ;
    rdfs:comment "INCLUSION CRITERIA"@en ;
    rdfs:subClassOf :ARCSection .

:DateQuestion a owl:Class ;
    rdfs:label "date question"@en ;
    rdfs:comment "A question whose answer is a date or datetime, represented as a time instant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom sulo:TimeInstant ],
        :ARCQuestion .

:MedicationRouteCollection a owl:Class ;
    rdfs:label "medication route answer option collection"@en ;
    rdfs:comment "A collection of the routes of administration of a medication: oral, subcutaneous, inhaled, IV, topical, unknown or other."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Inhaled ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Topical ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Subcutaneous ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Oral ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :IV ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Other ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Unknown ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:HospitalOutcomeCollection a owl:Class ;
    rdfs:label "hospital outcome answer option collection"@en ;
    rdfs:comment "A collection of the possible outcomes at the end of the hospital stay or study. ARC list: outcome_Outcome. Its items are added as named individuals in a later notebook."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :DischargedAgainstMedicalAdvice ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :StillHospitalised ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :DischargedAlive ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :AliveNotAdmitted ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :PalliativeCare ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Death ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Hospitalized ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :TransferToOtherFacility ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:SymptomsOnAdmissionSection a owl:Class ;
    rdfs:label "SYMPTOMS ON ADMISSION"@en ;
    rdfs:comment "SYMPTOMS ON ADMISSION: Indicate if experienced at any time from onset of this illness to the day of presentation."@en ;
    rdfs:subClassOf :ARCSection .

:ContactSettingCollection a owl:Class ;
    rdfs:label "contact setting answer option collection"@en ;
    rdfs:comment "A collection of the settings in which a contact may have occurred, such as household, community/social, healthcare facility, occupational/workplace, sexual contact, air travel/flight, vertical transmission, other or unknown."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :VerticalTransmission ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Unknown ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :CommunitySocial ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :SexualContact ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :OccupationalWorkplace ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Household ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :AirTravelFlight ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Other ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :HealthcareFacility ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:ARCForm a owl:Class ;
    rdfs:label "ARC Form"@en ;
    rdfs:comment "Root class for all ARC CRF forms. Subclasses are defined as equivalent to ARCForm & refersTo some <ProcessClass> to capture which clinical phase each form documents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom :ARCSection ],
        [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom sulo:Process ],
        sulo:InformationObject .

:MedicationDoseUnitCollection a owl:Class ;
    rdfs:label "medication dose unit answer option collection"@en ;
    rdfs:comment "A collection of the units in which a medication dose or rate may be expressed, such as mg, g, µg, IU, mg/kg, mg/day, mL, mL/h, %, tablets or other."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Other ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :MgKg ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :IU ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Percentage ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :UG ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :G ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :ML ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :MgDay ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Tablets ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :MLH ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Mg ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:BodySystem a owl:Class ;
    rdfs:label "Body system"@en ;
    rdfs:comment "Anatomical or functional body system used to categorise ARC clinical questions."@en ;
    rdfs:subClassOf sulo:SpatialObject .

:FollowUpOutcomeCollection a owl:Class ;
    rdfs:label "follow-up outcome answer option collection"@en ;
    rdfs:comment "A collection of the possible patient outcomes at follow-up. ARC list: followup_outcome. Its items are added as named individuals in a later notebook."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :EarlyWithdrawal ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :DischargedAlivePatientSPreference ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :LossToFollowUp ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :PalliativeCare ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :NoLesionsEverDevelopedAndNoSeriousComplications ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :TransferToOtherFacility ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :AllLesionsAreNoLongerActiveAndNoSeriousComplications ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Death ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :OneOrMoreLesionSAreActiveAndNoSeriousComplications ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :SeriousComplicationAndOrReHospitalisationDueToInfectionWithPathogenOfInterest ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :StillHospitalised ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :DischargedAliveMedicalGrounds ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :AllLesionsAreCompletelyResolvedAndNoSeriousComplications ;
            owl:onProperty sulo:hasItem ],
        :AnswerOptionCollection .

:NumberQuestion a owl:Class ;
    rdfs:label "number question"@en ;
    rdfs:comment "A question whose answer is a numeric value, represented as a quantity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom sulo:Quantity ],
        :ARCQuestion .

:AnswerOptionCollection a owl:Class ;
    rdfs:label "answer option collection"@en ;
    rdfs:comment "A collection of answer options for a question."@en ;
    rdfs:subClassOf sulo:Collection .

:ListQuestionSingle a owl:Class ;
    rdfs:label "list question (single choice)"@en ;
    rdfs:comment "A question that requires the selection of exactly one item from a list of options."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom :AnswerOptionCollection ],
        :ARCQuestion .

:MedicationTypeCollection a owl:Class ;
    rdfs:label "medication type answer option collection"@en ;
