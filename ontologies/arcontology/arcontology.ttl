            owl:hasValue :G ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :MLH ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :IU ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
            owl:hasValue :Mg ;
            owl:onProperty sulo:hasItem ],
        [ a owl:Restriction ;
