:Gastrointestinal a owl:Class ;
    rdfs:label "Gastrointestinal"@en ;
    rdfs:comment "Gastrointestinal"@en ;
    rdfs:subClassOf :BodySystem .

:InclusionCriteriaSection a owl:Class ;
